    <bpmn:sequenceFlow id="U06_Flow_39" sourceRef="U06_ack" targetRef="U06_error" name="Нет / сеть / ошибка"/>
    <bpmn:sequenceFlow id="U06_Flow_40" sourceRef="U06_error" targetRef="U06_retry"/>
    <bpmn:sequenceFlow id="U06_Flow_41" sourceRef="U06_retry" targetRef="U06_reconcile" name="Да: сверить исходную операцию"/>
    <bpmn:sequenceFlow id="U06_Flow_42" sourceRef="U06_retry" targetRef="U06_end" name="Нет: сохранить контекст и выйти"/>
    <bpmn:sequenceFlow id="U06_Flow_43" sourceRef="U06_reconcile" targetRef="U06_reconcile_result"/>
    <bpmn:sequenceFlow id="U06_Flow_44" sourceRef="U06_reconcile_result" targetRef="U06_result_kind" name="Подтверждено: результат уже есть"/>
    <bpmn:sequenceFlow id="U06_Flow_45" sourceRef="U06_reconcile_result" targetRef="U06_validate" name="Не сохранено: повторить тот же черновик"/>
    <bpmn:sequenceFlow id="U06_Flow_46" sourceRef="U06_reconcile_result" targetRef="U06_unconfirmed_end" name="Пока неизвестно / сеть недоступна"/>
