    <bpmn:sequenceFlow id="U05_Flow_21" sourceRef="U05_cancel_ack" targetRef="U05_unavailable" name="Нет права / состояние не допускает"/>
    <bpmn:sequenceFlow id="U05_Flow_22" sourceRef="U05_cancel_ack" targetRef="U05_ack_error" name="Ошибка / нет подтверждения"/>
    <bpmn:sequenceFlow id="U05_Flow_23" sourceRef="U05_ack" targetRef="U05_submitted" name="Да: подтверждено"/>
    <bpmn:sequenceFlow id="U05_Flow_24" sourceRef="U05_ack" targetRef="U05_ack_error" name="Нет / ошибка сети"/>
    <bpmn:sequenceFlow id="U05_Flow_25" sourceRef="U05_ack_error" targetRef="U05_ack_error_end"/>
    <bpmn:sequenceFlow id="U05_Flow_26" sourceRef="U05_submitted" targetRef="U05_read_status"/>
    <bpmn:sequenceFlow id="U05_Flow_27" sourceRef="U05_read_status" targetRef="U05_status"/>
    <bpmn:sequenceFlow id="U05_Flow_28" sourceRef="U05_status" targetRef="U05_pending_end" name="PENDING: решения пока нет"/>
    <bpmn:sequenceFlow id="U05_Flow_29" sourceRef="U05_status" targetRef="U05_waitlist" name="WAITLISTED: Event"/>
    <bpmn:sequenceFlow id="U05_Flow_30" sourceRef="U05_status" targetRef="U05_rejected" name="REJECTED"/>
