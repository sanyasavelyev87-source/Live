      <bpmn:outgoing>U04_Flow_1</bpmn:outgoing>
      <bpmn:outgoing>U04_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>U04_Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U04_dating" name="P13 · Знакомства: форматы, Open to Life, Signal, активности">
      <bpmn:documentation>Источники: P2183, P2184. Уровень: подтверждено/следствие. </bpmn:documentation>
