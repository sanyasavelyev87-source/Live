    <bpmn:sequenceFlow id="U05_Flow_51" sourceRef="U05_need_plan" targetRef="U05_plan" name="Да: согласовать детали"/>
    <bpmn:sequenceFlow id="U05_Flow_52" sourceRef="U05_need_plan" targetRef="U05_coordinated" name="Нет: всё уже определено"/>
    <bpmn:sequenceFlow id="U05_Flow_53" sourceRef="U05_plan" targetRef="U05_coordinated"/>
