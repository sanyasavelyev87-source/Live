        <bpmn:flowNodeRef>U05_waitlist_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_rejected_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_expired_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_chat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_context</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_signal_place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_signal_unconfirmed</bpmn:flowNodeRef>
