    <bpmn:sequenceFlow id="U06_Flow_18" sourceRef="U06_travel_no_right" targetRef="U06_end" name="Вернуться без объявления"/>
    <bpmn:sequenceFlow id="U06_Flow_19" sourceRef="U06_plus" targetRef="U06_p11"/>
    <bpmn:sequenceFlow id="U06_Flow_20" sourceRef="U06_travel_search" targetRef="U06_end"/>
    <bpmn:sequenceFlow id="U06_Flow_21" sourceRef="U06_travel_form" targetRef="U06_preview"/>
