        <bpmn:flowNodeRef>U04_origin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_peopleIntent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_filters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_otl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_travelIntent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_travelFilter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_permission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_intent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_retry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U04_Lane_main_1" name="Приложение LivCi · экран и контекст">
        <bpmn:flowNodeRef>U04_dating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_otlError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_socialEntry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_travel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_travelSelect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_travelCreate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_granted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_limited</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_limitedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_view</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_map</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_social</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_unavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_network</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U04_Lane_main_2" name="LivCi · сервер, данные и права">
        <bpmn:flowNodeRef>U04_otlSave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_otlAck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_geo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U04_stable</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="U04_s" name="Карта / Люди / карточка / ссылка по ID">
      <bpmn:outgoing>U04_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
