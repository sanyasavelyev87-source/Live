  </bpmn:process>
  <bpmn:collaboration id="U05_Collaboration">
    <bpmn:participant id="U05_Participant_main" name="U05 · Социальный цикл: запрос → встреча → связь" processRef="U05_Process_main"/>
  </bpmn:collaboration>
  <bpmn:process id="U06_Process_main" isExecutable="false">
    <bpmn:documentation>P11 содержит четыре актуальных действия. Съёмка и публикация разделены; камера/микрофон запрашиваются по функции. Серверное подтверждение обязательно для успеха. Plus даёт Travel-объявление и разрешённую публичную аудиторию, но не самостоятельный допуск к эфиру. Отмена, отсутствие права и ошибка имеют конечный выход. Источники DOCX: P0355, P0356, P0370, P0371, P0397, P0398, P0399, P0401, P0402, P0404, P0524, P0525, P0526, P0527, P0531, P0532, P1101, P2162, P2164, P2165, P2189, P2190, P2207, P2208, P2209, P2210, P2211, P2224, P2225, P2426, P2428, P2432, P2451, T0555. Референсы: UR12, UR13, UR07. Рабочая модель пути, не исполнение backend.</bpmn:documentation>
    <bpmn:laneSet id="U06_LaneSet_main">
      <bpmn:lane id="U06_Lane_main_0" name="User · Пользователь PERSONAL">
        <bpmn:flowNodeRef>U06_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_format</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_travel_no_right</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_travel_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_permissions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_live_setup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_preview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_publish_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_live</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U06_Lane_main_1" name="Client · Приложение LivCi">
        <bpmn:flowNodeRef>U06_p11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_video</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_live_denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_plus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_travel_search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_permission_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_permission_denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_capture_kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_unconfirmed_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_result_kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_published</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U06_Lane_main_2" name="Server · Сервер LivCi">
        <bpmn:flowNodeRef>U06_live_eligibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_live_allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_travel_right</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_travel_allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_command</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_ack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_reconcile_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U06_live_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="U06_start" name="Пользователь нажал «Создать»">
      <bpmn:documentation>Источники: P2162, P2207. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:outgoing>U06_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="U06_p11" name="P11: четыре действия создания">
      <bpmn:documentation>Источники: P0355, P1101, P2208. Уровень: подтверждено. Видео круг / Фото / Прямой эфир / Тревел. P0356 с тремя основными действиями — остаточное расхождение; актуальный прямой перечень содержит четыре.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_0</bpmn:incoming>
      <bpmn:incoming>U06_Flow_19</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="U06_format" name="Что выбрано на P11?">
      <bpmn:documentation>Источники: P2208. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_1</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U06_video" name="Выбран видеокруг: запись ≤90 сек">
      <bpmn:documentation>Источники: P2208, P2210. Уровень: подтверждено. 90 секунд — предел записи. TTL показа кружка — 90 минут.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_2</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="U06_photo" name="Выбрано фото">
      <bpmn:documentation>Источники: P2208. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_3</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="U06_live_eligibility" name="Проверить самостоятельный допуск эфира">
      <bpmn:documentation>Источники: P0397, P2209, P2426. Уровень: подтверждено. Разрешённый Venue/Event-организатор, безопасность и ACL. Plus сам по себе не выдаёт основание начать эфир.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_4</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U06_live_allowed" name="Эфир разрешён этому автору?">
      <bpmn:documentation>Источники: P0397, P2426. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_9</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U06_live_denied" name="Нет допуска: эфир не запускается">
      <bpmn:documentation>Источники: P0397, P2225. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_11</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="U06_travel_right" name="Проверить личное право Plus Travel">
      <bpmn:documentation>Источники: P0526, P2190, P2426. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_5</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U06_travel_allowed" name="Право объявления активно?">
      <bpmn:documentation>Источники: P0526, P2190. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_13</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_14</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="U06_travel_no_right" name="Как продолжить без Plus?">
      <bpmn:documentation>Источники: P0531, P2224. Уровень: инженерное уточнение. Платна публикация временного объявления, не вся вкладка Travel.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_15</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_16</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_17</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="U06_plus" name="Открыть P06 по выбору пользователя" calledElement="U08_Process_main">
      <bpmn:documentation>Источники: P2224, P2225. Уровень: инженерное уточнение. Вызов ограничен личным Plus. Возврат к P11; публикация после покупки не запускается автоматически.</bpmn:documentation>
      <bpmn:documentation>Детализация: U08.bpmn; calledElement разрешён внутри объединённого комплекта. Модель неисполняемая.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_16</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_19</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="U06_travel_search" name="Открыть бесплатный поиск Travel">
      <bpmn:documentation>Источники: P0524, P0531. Уровень: подтверждено. Поиск не ограничен радиусом Signal. Основной TRAVEL Moment и трёхчасовое объявление — разные объекты (P0532).</bpmn:documentation>
      <bpmn:incoming>U06_Flow_17</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="U06_travel_form" name="Travel: одна страна, даты и аудитория">
      <bpmn:documentation>Источники: P0525, P0527, P2189, P2190. Уровень: подтверждено. Отдельный включаемый слой; объявление 3 часа, а поездка имеет свои даты.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_14</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U06_permissions" name="Разрешить камеру / нужный микрофон">
      <bpmn:documentation>Источники: P2209, P2432. Уровень: инженерное уточнение. Только для выбранной функции и до захвата. Уже достаточное разрешение не запрашивается заново; фото не требует произвольно всех разрешений.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_7</bpmn:incoming>
      <bpmn:incoming>U06_Flow_8</bpmn:incoming>
      <bpmn:incoming>U06_Flow_10</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U06_permission_ok" name="Достаточное разрешение получено?">
      <bpmn:documentation>Источники: P2209, P2432. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_22</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_23</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U06_permission_denied" name="Отказ: повтор / настройки, без захвата">
      <bpmn:documentation>Источники: P2432. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_24</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="U06_capture_kind" name="Какой медиарежим выбран?">
      <bpmn:documentation>Источники: P2208, P2209. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_23</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_26</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U06_capture" name="Снять фото / видеокруг ≤90 сек">
      <bpmn:documentation>Источники: P0404, P2208, P2210. Уровень: подтверждено. Встроенная камера: фронтальная/основная. Захват ещё не означает публикацию.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_26</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U06_live_setup" name="Подготовить и подтвердить старт эфира">
      <bpmn:documentation>Источники: P0397, P0404, P2209. Уровень: подтверждено. Только после самостоятельного допуска и разрешений.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_27</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U06_preview" name="Проверить черновик и аудиторию">
      <bpmn:documentation>Источники: P0370, P2209, P2428. Уровень: подтверждено. Кружки по умолчанию контактам; публичная аудитория собственных кружков — добровольное право Plus. Travel проверяется как отдельное объявление.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_21</bpmn:incoming>
      <bpmn:incoming>U06_Flow_28</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U06_publish_choice" name="Подтвердить публикацию?">
      <bpmn:documentation>Источники: P2209, P2428. Уровень: инженерное уточнение. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_29</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_30</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U06_validate" name="Перепроверить автора, права и аудиторию">
      <bpmn:documentation>Источники: P2209, P2426. Уровень: подтверждено. Проверка перед записью: сессия/ACL/блокировки/entitlement, Travel одна страна; для эфира самостоятельный допуск. Скрытия кнопки на клиенте недостаточно.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_30</bpmn:incoming>
      <bpmn:incoming>U06_Flow_32</bpmn:incoming>
      <bpmn:incoming>U06_Flow_45</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U06_valid" name="Серверные условия выполнены?">
      <bpmn:documentation>Источники: P2426. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_33</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_34</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U06_invalid" name="Показать причину отказа">
      <bpmn:documentation>Источники: P2165, P2426. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_35</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="U06_command" name="Сохранить объект / начать разрешённый эфир">
      <bpmn:documentation>Источники: P2209, P2428. Уровень: подтверждено. Идемпотентная команда. Неподтверждённый черновик не изображается опубликованным.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_34</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U06_ack" name="Результат сервера подтверждён?">
      <bpmn:documentation>Источники: P2211, P2432, P2451. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_37</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_38</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_39</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U06_error" name="Ошибка: сохранить контекст без успеха">
      <bpmn:documentation>Источники: P2211, P2428, P2432, P2451. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_39</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="U06_retry" name="Безопасно повторить?">
      <bpmn:documentation>Источники: P2211, P2428. Уровень: инженерное уточнение. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_40</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_41</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U06_reconcile" name="Сверить операцию по ID и тому же payload">
      <bpmn:documentation>Источники: P2428, P2451. Уровень: инженерное уточнение. idempotency key / operation ID — инженерное средство идемпотентности, не новое продуктовое поле. Сверить серверный результат исходной команды, сохранить уже снятые медиа/Travel-черновик; не запускать камеру заново. Для эфира сверить и текущий lifecycle: завершённый эфир не перезапускается как результат повтора.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_41</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_43</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U06_reconcile_result" name="Что известно об исходной операции?">
      <bpmn:documentation>Источники: P2428, P2451. Уровень: инженерное уточнение. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_43</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_44</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_45</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_46</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="U06_unconfirmed_end" name="Результат неизвестен; успех не показан">
      <bpmn:documentation>Источники: P2428, P2432, P2451. Уровень: инженерное уточнение. Сохранить исходный контекст/черновик и идентификатор операции. Не публиковать дубликат и не выдавать неизвестный исход за отказ или успех. Текущий просмотр имеет конечный выход.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_46</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="U06_result_kind" name="Что подтверждено сервером?">
      <bpmn:documentation>Источники: P2209, P2432. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_38</bpmn:incoming>
      <bpmn:incoming>U06_Flow_44</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_47</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_48</bpmn:outgoing>
      <bpmn:outgoing>U06_Flow_49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U06_live" name="Вести / завершить эфир ≤5 часов">
      <bpmn:documentation>Источники: P0398, P0399, P0404. Уровень: подтверждено. Сервер ограничивает длительность 5 часами; камера переключается без окончания. Круг Venue виден только пока Venue открыт. Закрытие маркера не означает автоматическое техническое прекращение передачи. Ручное завершение и технический обрыв могут закончить эфир раньше предела; сеть не подменяет серверный результат.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_47</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_50</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="U06_live_end" name="Завершить эфир; обновить видимость">
      <bpmn:documentation>Источники: P0398, P0401, P0402. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_48</bpmn:incoming>
      <bpmn:incoming>U06_Flow_50</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_51</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="U06_published" name="Показать подтверждённый результат">
      <bpmn:documentation>Источники: P0371, P0525, P2190, P2210. Уровень: подтверждено. Кружок: 90 минут на карте. Travel: отдельный слой, 3 часа, одна страна. Не постоянные маркеры и не срок поездки.</bpmn:documentation>
      <bpmn:incoming>U06_Flow_49</bpmn:incoming>
      <bpmn:outgoing>U06_Flow_52</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="U06_end" name="Вернуться к доступному контексту">
      <bpmn:documentation>Источники: P2164, P2211. Уровень: инженерное уточнение. </bpmn:documentation>
      <bpmn:incoming>U06_Flow_6</bpmn:incoming>
      <bpmn:incoming>U06_Flow_12</bpmn:incoming>
      <bpmn:incoming>U06_Flow_18</bpmn:incoming>
      <bpmn:incoming>U06_Flow_20</bpmn:incoming>
      <bpmn:incoming>U06_Flow_25</bpmn:incoming>
      <bpmn:incoming>U06_Flow_31</bpmn:incoming>
      <bpmn:incoming>U06_Flow_36</bpmn:incoming>
      <bpmn:incoming>U06_Flow_42</bpmn:incoming>
      <bpmn:incoming>U06_Flow_51</bpmn:incoming>
      <bpmn:incoming>U06_Flow_52</bpmn:incoming>
    </bpmn:endEvent>
