    <bpmn:callActivity id="U04_travelCreate" name="U06 · Создать объявление Тревел" calledElement="U06_Process_main">
      <bpmn:documentation>Источники: P2189, P2190. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:documentation>Детализация: U06.bpmn; calledElement разрешён внутри объединённого комплекта. Модель неисполняемая.</bpmn:documentation>
      <bpmn:incoming>U04_Flow_19</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_23</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="U04_need" name="Нужны реальные координаты для выбранной функции?">
      <bpmn:documentation>Источники: . Уровень: подтверждено/следствие. Например, Signal / «моя позиция». Смена города и просмотр доступных объектов не дают права раскрывать GPS профилей.</bpmn:documentation>
      <bpmn:incoming>U04_Flow_1</bpmn:incoming>
      <bpmn:incoming>U04_Flow_9</bpmn:incoming>
      <bpmn:incoming>U04_Flow_22</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_24</bpmn:outgoing>
      <bpmn:outgoing>U04_Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U04_permission" name="Контекстно запросить геодоступ ОС">
      <bpmn:incoming>U04_Flow_24</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U04_granted" name="Доступ и координаты доступны?">
      <bpmn:incoming>U04_Flow_26</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_27</bpmn:outgoing>
      <bpmn:outgoing>U04_Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U04_geo" name="Проверить реальные координаты для функции">
      <bpmn:documentation>Источники: P0244, P1555. Уровень: подтверждено/следствие. Для Signal фиксированные 1,5 км; центр карты не заменяет позицию пользователя.</bpmn:documentation>
      <bpmn:incoming>U04_Flow_27</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="U04_limited" name="Объяснить ограничение этой функции; сохранить контекст">
      <bpmn:documentation>Источники: . Уровень: инженерное уточнение. Отказ GPS не закрывает весь личный аккаунт. Точный экран отказа не утверждён.</bpmn:documentation>
      <bpmn:incoming>U04_Flow_28</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="U04_limitedEnd" name="Функция с геоданными не выполнена">
      <bpmn:incoming>U04_Flow_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="U04_read" name="Прочитать актуальные сущности: ACL, блокировки, TTL по времени БД">
      <bpmn:documentation>Источники: P1552, P1567, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U04_Flow_21</bpmn:incoming>
      <bpmn:incoming>U04_Flow_25</bpmn:incoming>
      <bpmn:incoming>U04_Flow_30</bpmn:incoming>
      <bpmn:incoming>U04_Flow_43</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U04_result" name="Результат чтения?">
      <bpmn:incoming>U04_Flow_31</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_32</bpmn:outgoing>
      <bpmn:outgoing>U04_Flow_33</bpmn:outgoing>
      <bpmn:outgoing>U04_Flow_34</bpmn:outgoing>
      <bpmn:outgoing>U04_Flow_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="U04_view" name="Это карта / поиск или целевой объект?">
      <bpmn:incoming>U04_Flow_32</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_36</bpmn:outgoing>
      <bpmn:outgoing>U04_Flow_37</bpmn:outgoing>
      <bpmn:outgoing>U04_Flow_38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U04_map" name="Серверные фильтры → кластеры по масштабу → карта">
      <bpmn:documentation>Источники: P1559, P1561, P2433. Уровень: подтверждено/следствие. Четыре канонических временных режима NOW/TODAY/WEEKEND/LATER. Подписи P14/P16 не имеют утверждённого соответствия; тема карты по часовому поясу показанного города.</bpmn:documentation>
      <bpmn:incoming>U04_Flow_36</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_45</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="U04_list" name="Показать разрешённые результаты формата / список поездок">
      <bpmn:documentation>Источники: P2184, P2188, P2189. Уровень: подтверждено/следствие. Не заменять поиск Тревел только картой. Сохранить направление, фильтры и позиции результатов.</bpmn:documentation>
      <bpmn:incoming>U04_Flow_37</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_46</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="U04_card" name="Показать разрешённую актуальную карточку">
      <bpmn:documentation>Источники: . Уровень: подтверждено/следствие. Обычный профиль не становится постоянным GPS маркером. Карточка и маркер имеют разные условия жизни.</bpmn:documentation>
      <bpmn:incoming>U04_Flow_38</bpmn:incoming>
      <bpmn:incoming>U04_Flow_40</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_47</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="U04_intent" name="В карточке выбрано разрешённое социальное действие?">
      <bpmn:incoming>U04_Flow_47</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_48</bpmn:outgoing>
      <bpmn:outgoing>U04_Flow_49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="U04_social" name="U05 · Запрос / участие / встреча" calledElement="U05_Process_main">
      <bpmn:documentation>Детализация: U05.bpmn; calledElement разрешён внутри объединённого комплекта. Модель неисполняемая.</bpmn:documentation>
      <bpmn:incoming>U04_Flow_48</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_50</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="U04_expired" name="Скрыть истёкший маркер; проверить доступ к стабильной карточке">
      <bpmn:incoming>U04_Flow_33</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_39</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U04_stable" name="Стабильная карточка разрешена?">
      <bpmn:incoming>U04_Flow_39</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_40</bpmn:outgoing>
      <bpmn:outgoing>U04_Flow_41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U04_unavailable" name="Показать причину: скрыто / нет прав / истекло / пусто">
      <bpmn:documentation>Источники: P2165, P2422. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U04_Flow_34</bpmn:incoming>
      <bpmn:incoming>U04_Flow_41</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_51</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="U04_network" name="Показать ошибку сети, не выдавать кэш за актуальное">
      <bpmn:incoming>U04_Flow_35</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="U04_retry" name="Повторить чтение?">
      <bpmn:incoming>U04_Flow_42</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_43</bpmn:outgoing>
      <bpmn:outgoing>U04_Flow_44</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="U04_wait" name="Состояние не подтверждено; контекст сохранён">
      <bpmn:incoming>U04_Flow_44</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="U04_back" name="Назад · вкладка / фильтры / скролл / источник">
      <bpmn:documentation>Источники: P2164, P2422. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U04_Flow_8</bpmn:incoming>
      <bpmn:incoming>U04_Flow_12</bpmn:incoming>
      <bpmn:incoming>U04_Flow_14</bpmn:incoming>
      <bpmn:incoming>U04_Flow_15</bpmn:incoming>
      <bpmn:incoming>U04_Flow_20</bpmn:incoming>
      <bpmn:incoming>U04_Flow_23</bpmn:incoming>
      <bpmn:incoming>U04_Flow_45</bpmn:incoming>
      <bpmn:incoming>U04_Flow_46</bpmn:incoming>
      <bpmn:incoming>U04_Flow_49</bpmn:incoming>
      <bpmn:incoming>U04_Flow_50</bpmn:incoming>
      <bpmn:incoming>U04_Flow_51</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_52</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="U04_end" name="Просмотр / результат завершён">
      <bpmn:incoming>U04_Flow_52</bpmn:incoming>
    </bpmn:endEvent>
