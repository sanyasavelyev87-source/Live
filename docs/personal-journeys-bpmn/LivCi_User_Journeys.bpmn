    <bpmn:sequenceFlow id="U06_Flow_30" sourceRef="U06_publish_choice" targetRef="U06_validate" name="Да: явное подтверждение"/>
    <bpmn:sequenceFlow id="U06_Flow_31" sourceRef="U06_publish_choice" targetRef="U06_end" name="Нет: отменить черновик"/>
    <bpmn:sequenceFlow id="U06_Flow_32" sourceRef="U06_live_setup" targetRef="U06_validate"/>
