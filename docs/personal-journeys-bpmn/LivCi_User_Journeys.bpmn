    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U04_filters" name="Открыть форму формата и фильтры">
      <bpmn:documentation>Источники: P2184, P2185. Уровень: подтверждено/следствие. Свидание: возраст и рост обязательны; знакомства/компания: также пол и кого ищу; интересы необязательны. Не свайп-лента анкет.</bpmn:documentation>
      <bpmn:incoming>U04_Flow_5</bpmn:incoming>
      <bpmn:outgoing>U04_Flow_9</bpmn:outgoing>
    </bpmn:userTask>
