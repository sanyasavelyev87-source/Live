<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="LivCi_User_Journeys_Definitions" targetNamespace="urn:livci:personal-journeys:2026-10-16" exporter="LivCi personal journeys specification" exporterVersion="1.0"><bpmn:process id="U01_Process_main" isExecutable="false">
    <bpmn:documentation>Начало после подтверждённого R09: переход на карту без повторной анкеты, обязательной оплаты или общего запроса GPS. Ошибки загрузки не превращаются в успешный вход. Источники DOCX: P2315, P2317, P2162, P2165, P2220, P2171. Референсы: DR09, UR15, DP16. Рабочая модель пути, не исполнение backend.</bpmn:documentation>
    <bpmn:laneSet id="U01_LaneSet_main">
      <bpmn:lane id="U01_Lane_main_0" name="Пользователь · действие и выбор">
        <bpmn:flowNodeRef>U01_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U01_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U01_retry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U01_Lane_main_1" name="Приложение LivCi · экран и контекст">
        <bpmn:flowNodeRef>U01_load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U01_map</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U01_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U01_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U01_pause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U01_reauth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U01_handed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U01_Lane_main_2" name="LivCi · сервер, данные и права">
        <bpmn:flowNodeRef>U01_bootstrap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U01_result</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="U01_s" name="Регистрация завершена · R09">
      <bpmn:documentation>Источники: P2315, P2317. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:outgoing>U01_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="U01_go" name="Нажать «Перейти к карте»">
      <bpmn:documentation>Источники: P2315, P2316. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U01_Flow_0</bpmn:incoming>
      <bpmn:outgoing>U01_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="U01_load" name="Загрузка карты и исходного контекста">
      <bpmn:incoming>U01_Flow_1</bpmn:incoming>
      <bpmn:outgoing>U01_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U01_bootstrap" name="Прочитать существующий профиль, права и актуальные данные">
      <bpmn:documentation>Источники: P2169, P2220, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U01_Flow_2</bpmn:incoming>
      <bpmn:incoming>U01_Flow_8</bpmn:incoming>
      <bpmn:outgoing>U01_Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U01_result" name="Ответ сервера?">
      <bpmn:incoming>U01_Flow_3</bpmn:incoming>
      <bpmn:outgoing>U01_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>U01_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>U01_Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U01_map" name="Показать P14 / P16 · карту и пять разделов">
      <bpmn:documentation>Источники: P2162, P2317. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U01_Flow_4</bpmn:incoming>
      <bpmn:outgoing>U01_Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="U01_ready" name="Карта готова · свободный выбор U03">
      <bpmn:incoming>U01_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="U01_error" name="Показать ошибку / нет сети; сохранить контекст">
      <bpmn:documentation>Источники: P2165, P2171. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U01_Flow_6</bpmn:incoming>
      <bpmn:outgoing>U01_Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="U01_retry" name="Повторить загрузку?">
      <bpmn:incoming>U01_Flow_7</bpmn:incoming>
      <bpmn:outgoing>U01_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>U01_Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="U01_pause" name="Загрузка не завершена; можно вернуться">
      <bpmn:incoming>U01_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="U01_reauth" name="U02 · Восстановить вход" calledElement="U02_Process_main">
      <bpmn:documentation>Источники: . Уровень: подтверждено/следствие. Только при явном ответе о недействительной сессии; не при сетевой неопределённости.</bpmn:documentation>
      <bpmn:documentation>Детализация: U02.bpmn; calledElement разрешён внутри объединённого комплекта. Модель неисполняемая.</bpmn:documentation>
      <bpmn:incoming>U01_Flow_10</bpmn:incoming>
      <bpmn:outgoing>U01_Flow_11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="U01_handed" name="Продолжение через U02">
      <bpmn:incoming>U01_Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="U01_Flow_0" sourceRef="U01_s" targetRef="U01_go"/>
    <bpmn:sequenceFlow id="U01_Flow_1" sourceRef="U01_go" targetRef="U01_load"/>
    <bpmn:sequenceFlow id="U01_Flow_2" sourceRef="U01_load" targetRef="U01_bootstrap"/>
    <bpmn:sequenceFlow id="U01_Flow_3" sourceRef="U01_bootstrap" targetRef="U01_result"/>
    <bpmn:sequenceFlow id="U01_Flow_4" sourceRef="U01_result" targetRef="U01_map" name="Данные готовы"/>
    <bpmn:sequenceFlow id="U01_Flow_5" sourceRef="U01_map" targetRef="U01_ready"/>
    <bpmn:sequenceFlow id="U01_Flow_6" sourceRef="U01_result" targetRef="U01_error" name="Нет сети / ошибка"/>
    <bpmn:sequenceFlow id="U01_Flow_7" sourceRef="U01_error" targetRef="U01_retry"/>
    <bpmn:sequenceFlow id="U01_Flow_8" sourceRef="U01_retry" targetRef="U01_bootstrap" name="Повторить"/>
    <bpmn:sequenceFlow id="U01_Flow_9" sourceRef="U01_retry" targetRef="U01_pause" name="Позже"/>
    <bpmn:sequenceFlow id="U01_Flow_10" sourceRef="U01_result" targetRef="U01_reauth" name="Сессия явно недействительна"/>
    <bpmn:sequenceFlow id="U01_Flow_11" sourceRef="U01_reauth" targetRef="U01_handed"/>
  </bpmn:process>
  <bpmn:collaboration id="U01_Collaboration">
    <bpmn:participant id="U01_Participant_main" name="Первый вход после регистрации" processRef="U01_Process_main"/>
  </bpmn:collaboration>
  <bpmn:process id="U02_Process_main" isExecutable="false">
    <bpmn:documentation>Холодный запуск, возврат из фона, восстановление связи и уведомление/deep link. Сессия имеет три исхода; затем серверное обновление и разрешённая точка назначения. Источники DOCX: P2169, P1651, P1703, P1704, P2121, P2164, P2422, P2426, P2451. Референсы: UR01, UR15, DP16, UR06. Рабочая модель пути, не исполнение backend.</bpmn:documentation>
    <bpmn:laneSet id="U02_LaneSet_main">
      <bpmn:lane id="U02_Lane_main_0" name="Пользователь · действие и выбор">
        <bpmn:flowNodeRef>U02_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_accountType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_role</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_retry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U02_Lane_main_1" name="Приложение LivCi · экран и контекст">
        <bpmn:flowNodeRef>U02_entry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_splash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_business</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_incomplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_offline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_offlineEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_target</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_deep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_context</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U02_Lane_main_2" name="LivCi · сервер, данные и права">
        <bpmn:flowNodeRef>U02_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_sessionResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_authResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_fresh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U02_freshResult</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="U02_s" name="Запуск / foreground / reconnect / ссылка">
      <bpmn:outgoing>U02_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="U02_entry" name="Сохранить тип входа и запрошенный контекст">
      <bpmn:documentation>Источники: . Уровень: инженерное уточнение. Не обещает сохранение deep link через переустановку или восстановление последней вкладки после холодного запуска.</bpmn:documentation>
      <bpmn:incoming>U02_Flow_0</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U02_kind" name="Обычный холодный запуск?">
      <bpmn:incoming>U02_Flow_1</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>U02_Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U02_splash" name="P15 · начальная загрузка">
      <bpmn:documentation>Источники: P2169. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U02_Flow_2</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="U02_session" name="Проверить сессию по API">
      <bpmn:documentation>Источники: P2426, P1207. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U02_Flow_3</bpmn:incoming>
      <bpmn:incoming>U02_Flow_4</bpmn:incoming>
      <bpmn:incoming>U02_Flow_19</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U02_sessionResult" name="Состояние сессии?">
      <bpmn:incoming>U02_Flow_5</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>U02_Flow_7</bpmn:outgoing>
      <bpmn:outgoing>U02_Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U02_auth" name="Личный вход: телефон / email / Google / Apple">
      <bpmn:documentation>Источники: T0611, P0612. Уровень: подтверждено/следствие. Регистрация нового аккаунта находится вне основного пути. SMS не навязывается другим методам.</bpmn:documentation>
      <bpmn:incoming>U02_Flow_10</bpmn:incoming>
      <bpmn:incoming>U02_Flow_16</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U02_accountType" name="R01 · Выбрать тип аккаунта">
      <bpmn:documentation>Источники: P2169, P2268. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U02_Flow_7</bpmn:incoming>
      <bpmn:incoming>U02_Flow_24</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U02_role" name="Выбран личный маршрут?">
      <bpmn:incoming>U02_Flow_9</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>U02_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="U02_business" name="Бизнес-маршрут BV01 / BV02 · вне личного процесса">
      <bpmn:documentation>Источники: P2268. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U02_Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="U02_authResult" name="Результат входа?">
      <bpmn:incoming>U02_Flow_12</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_13</bpmn:outgoing>
      <bpmn:outgoing>U02_Flow_14</bpmn:outgoing>
      <bpmn:outgoing>U02_Flow_15</bpmn:outgoing>
      <bpmn:outgoing>U02_Flow_16</bpmn:outgoing>
      <bpmn:outgoing>U02_Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="U02_incomplete" name="Передать в незавершённую регистрацию">
      <bpmn:documentation>Источники: . Уровень: инженерное уточнение. Точная политика восстановления шага не задана. Подтверждённый контакт не равен завершённому профилю R09.</bpmn:documentation>
      <bpmn:incoming>U02_Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="U02_cancel" name="Вход отменён · приватные данные недоступны">
      <bpmn:incoming>U02_Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="U02_offline" name="Нет сети / ошибка · ограниченный безопасный режим">
      <bpmn:documentation>Источники: P1703, P1704, P2165. Уровень: инженерное уточнение. Точный offline UI и допуск к приватному локальному кэшу требуют отдельного решения. Кэш не подтверждает сессию, права, оплату или вместимость.</bpmn:documentation>
      <bpmn:incoming>U02_Flow_8</bpmn:incoming>
      <bpmn:incoming>U02_Flow_17</bpmn:incoming>
      <bpmn:incoming>U02_Flow_23</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="U02_retry" name="Повторить после восстановления связи?">
      <bpmn:incoming>U02_Flow_18</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_19</bpmn:outgoing>
      <bpmn:outgoing>U02_Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="U02_offlineEnd" name="Офлайн: серверные действия не подтверждены">
      <bpmn:incoming>U02_Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="U02_fresh" name="Сверить данные, ACL, сроки, подписку и непрочитанное">
      <bpmn:documentation>Источники: P1651, P1704, P1552, P1567, P1617, P1618, P1619, T2420. Уровень: подтверждено/следствие. Reconnect требует API resync. Проверка при foreground — инженерная реализация актуальности; не требование каждый раз заново загружать все медиа.</bpmn:documentation>
      <bpmn:incoming>U02_Flow_6</bpmn:incoming>
      <bpmn:incoming>U02_Flow_13</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U02_freshResult" name="Свежий ответ получен?">
      <bpmn:incoming>U02_Flow_21</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_22</bpmn:outgoing>
      <bpmn:outgoing>U02_Flow_23</bpmn:outgoing>
      <bpmn:outgoing>U02_Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="U02_target" name="Какой сохранённый тип входа?">
      <bpmn:incoming>U02_Flow_22</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_25</bpmn:outgoing>
      <bpmn:outgoing>U02_Flow_26</bpmn:outgoing>
      <bpmn:outgoing>U02_Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="U02_deep" name="U04 · Проверить entity_type + ID, ACL и TTL" calledElement="U04_Process_main">
      <bpmn:documentation>Источники: P2121, P2422. Уровень: подтверждено/следствие. Открыть целевой объект или явную причину недоступности, а не молча отправлять на главную.</bpmn:documentation>
      <bpmn:documentation>Детализация: U04.bpmn; calledElement разрешён внутри объединённого комплекта. Модель неисполняемая.</bpmn:documentation>
      <bpmn:incoming>U02_Flow_25</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_28</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="U02_context" name="Восстановить вкладку, фильтры, скролл и разрешённый объект">
      <bpmn:documentation>Источники: P2164, P2422. Уровень: подтверждено/следствие. Только сохранённый контекст живого возврата/связи. Истёкшие сущности получают актуальный статус; TTL не перезапускается.</bpmn:documentation>
      <bpmn:incoming>U02_Flow_26</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="U02_home" name="Показать главную карту P14 / P16">
      <bpmn:documentation>Источники: P2169. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U02_Flow_27</bpmn:incoming>
      <bpmn:outgoing>U02_Flow_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="U02_end" name="Вход восстановлен · далее U03">
      <bpmn:incoming>U02_Flow_28</bpmn:incoming>
      <bpmn:incoming>U02_Flow_29</bpmn:incoming>
      <bpmn:incoming>U02_Flow_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="U02_Flow_0" sourceRef="U02_s" targetRef="U02_entry"/>
    <bpmn:sequenceFlow id="U02_Flow_1" sourceRef="U02_entry" targetRef="U02_kind"/>
    <bpmn:sequenceFlow id="U02_Flow_2" sourceRef="U02_kind" targetRef="U02_splash" name="Да"/>
    <bpmn:sequenceFlow id="U02_Flow_3" sourceRef="U02_kind" targetRef="U02_session" name="Нет · фон / связь / ссылка"/>
    <bpmn:sequenceFlow id="U02_Flow_4" sourceRef="U02_splash" targetRef="U02_session"/>
    <bpmn:sequenceFlow id="U02_Flow_5" sourceRef="U02_session" targetRef="U02_sessionResult"/>
    <bpmn:sequenceFlow id="U02_Flow_6" sourceRef="U02_sessionResult" targetRef="U02_fresh" name="Действительна"/>
    <bpmn:sequenceFlow id="U02_Flow_7" sourceRef="U02_sessionResult" targetRef="U02_accountType" name="Явно недействительна / нет входа"/>
    <bpmn:sequenceFlow id="U02_Flow_8" sourceRef="U02_sessionResult" targetRef="U02_offline" name="Неизвестно · сеть / ошибка"/>
    <bpmn:sequenceFlow id="U02_Flow_9" sourceRef="U02_accountType" targetRef="U02_role"/>
    <bpmn:sequenceFlow id="U02_Flow_10" sourceRef="U02_role" targetRef="U02_auth" name="Личный"/>
