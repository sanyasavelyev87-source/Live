    <bpmn:sequenceFlow id="U05_Flow_39" sourceRef="U05_offer_result" targetRef="U05_waitlist_end" name="Нет: offer / место недействительны"/>
    <bpmn:sequenceFlow id="U05_Flow_40" sourceRef="U05_offer_result" targetRef="U05_ack_error" name="Результат не подтверждён"/>
    <bpmn:sequenceFlow id="U05_Flow_41" sourceRef="U05_rejected" targetRef="U05_rejected_end"/>
    <bpmn:sequenceFlow id="U05_Flow_42" sourceRef="U05_expired" targetRef="U05_expired_end"/>
    <bpmn:sequenceFlow id="U05_Flow_43" sourceRef="U05_chat" targetRef="U05_context"/>
    <bpmn:sequenceFlow id="U05_Flow_44" sourceRef="U05_context" targetRef="U05_signal_agree" name="Signal"/>
    <bpmn:sequenceFlow id="U05_Flow_45" sourceRef="U05_context" targetRef="U05_need_plan" name="Moment"/>
    <bpmn:sequenceFlow id="U05_Flow_46" sourceRef="U05_context" targetRef="U05_event_place" name="Event"/>
