    <bpmn:startEvent id="U08_start" name="Профиль или прямой чат">
      <bpmn:documentation>Источники: P2213, P2229. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:outgoing>U08_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="U08_entry" name="Откуда открыт сценарий?">
      <bpmn:documentation>Источники: P2213, P2229. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_0</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_1</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U08_menu" name="Показать P07 и Мои подписки перед выходом">
      <bpmn:documentation>Источники: P1108, P2016, P2214. Уровень: подтверждено/следствие. Меню/панель профиля; геометрия раскрытия не задана. Мои комьюнити означает созданные мной, а не любое членство. Unread с сервера.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_1</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="U08_choose" name="Выбрать вложенный раздел или выход">
      <bpmn:documentation>Источники: P2016. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_3</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U08_route" name="Выбранный пункт P07?">
      <bpmn:documentation>Источники: P2016, T2435. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_4</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_7</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_9</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U08_profile" name="Просмотреть / изменить свой Profile P02">
      <bpmn:documentation>Источники: P2218, P2219, P2427. Уровень: подтверждено/следствие. О себе, возраст, интересы, настройки приватности, фото. Посмотреть мой профиль — публичная разрешённая проекция, назад возвращает в кабинет; новое Profile не создаётся.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_5</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U08_edit" name="Сохранить изменения анкеты?">
      <bpmn:documentation>Источники: P1114, P2026. Уровень: подтверждено/следствие. Просмотр, предпросмотр и возврат не требуют изменения анкеты.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_12</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_13</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U08_save" name="Проверить 1–5 фото, ник и сохранить Profile">
      <bpmn:documentation>Источники: P0338, P0348, P2220, P2427, P2438. Уровень: подтверждено/следствие. Ник уникален без учёта регистра; единые Profile/Interest. Ошибка не публикует частично сохранённый черновик.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_13</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U08_filters" name="Показать P05: поиск и 4 фильтра">
      <bpmn:documentation>Источники: P2228, P2229. Уровень: подтверждено/следствие. Все / Личные / Групповые / Сообщества; только разрешённые Conversation, серверные unread. Запрос списка каждый раз проверяет ACL; фильтры не меняют права. Пусто/сеть/ошибка/нет доступа различаются.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_6</bpmn:incoming>
      <bpmn:incoming>U08_Flow_18</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U08_list_state" name="Состояние списка P05 и действие?">
      <bpmn:documentation>Источники: P2165, P2228, P2229. Уровень: подтверждено/следствие. Выбирать чат можно только при доступной строке. Повтор — только чтение/поиск списка, без Message или нового chat_id.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_16</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_17</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_18</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U08_pick" name="Выбрать существующую беседу">
      <bpmn:documentation>Источники: P2229. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_17</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="U08_direct" name="Принять chat_id из U05 / U07">
      <bpmn:documentation>Источники: P1126, P2229. Уровень: подтверждено/следствие. Прямой вход из Signal/Moment/Travel/Event/Community обходит P07; не создаёт новую беседу вместо контекстной.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_2</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U08_chat_acl" name="Проверить участника и тот же chat_id">
      <bpmn:documentation>Источники: P0539, P0543, P0544, P0545, P2447. Уровень: подтверждено/следствие. Plan/Meeting используют чат исходного контекста. TTL объявления не удаляет разрешённый чат. Скрытая команда бизнеса не раскрывается.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_20</bpmn:incoming>
      <bpmn:incoming>U08_Flow_21</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U08_chat_access" name="Чат доступен?">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_22</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_23</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U08_thread" name="Показать беседу; синхронизировать unread">
      <bpmn:documentation>Источники: P2229, T2420. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_23</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U08_chat_action" name="Отправить сообщение или вернуться?">
      <bpmn:documentation>Источники: P2229, P2164. Уровень: подтверждено/следствие. Чтение беседы не требует отправки сообщения.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_25</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_26</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U08_compose" name="Написать сообщение и отправить">
      <bpmn:documentation>Источники: P0538, P2428. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_26</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="U08_send" name="Проверить ACL и подтвердить запись Message">
      <bpmn:documentation>Источники: P0545, P2426, P2428. Уровень: подтверждено/следствие. Повтор отправки идемпотентен. Сетевой запрос ещё не является подтверждённой записью; Sent возможен только после ack.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_28</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U08_ack" name="Сервер подтвердил сообщение?">
      <bpmn:documentation>Источники: P2424, P2428. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_29</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_30</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U08_sent" name="Показать Sent после серверного ack">
      <bpmn:documentation>Источники: P2424, P2428. Уровень: инженерное следствие. Надпись Sent обозначает подтверждённую запись, не прочтение получателем.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_30</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U08_draft" name="Сохранить draft; показать сбой отправки">
      <bpmn:documentation>Источники: P2165, P2428. Уровень: инженерное следствие. Не показывать Sent; сохранить текст и контекст для безопасного повтора.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_31</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U08_activities" name="Выдать P04: Saved / Events / Moments / Circles">
      <bpmn:documentation>Источники: P2233, P2234, P2235, P2254, P2257. Уровень: подтверждено/следствие. Единые ID, актуальные ACL/TTL. Сохранённое не становится постоянным маркером; кружок 90 минут на карте, оригинал ещё 30 дней/Archive.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_7</bpmn:incoming>
      <bpmn:incoming>U08_Flow_36</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U08_activity_list" name="Состояние списка P04 и действие?">
      <bpmn:documentation>Источники: P2165, P2233, P2234. Уровень: подтверждено/следствие. Пусто / сеть / ошибка / скрыто / истёкший маркер различаются. До выбора карточки разрешены возврат или повтор только чтения. TTL не продлевается, команда создания/участия не повторяется.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_34</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_35</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_36</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U08_activity_pick" name="Выбрать актуальную карточку активности">
      <bpmn:documentation>Источники: P2234. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_35</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_38</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U08_activity_route" name="Какой контекст активности?">
      <bpmn:documentation>Источники: P2234. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_38</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_39</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_40</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="U08_social" name="Moment / Meeting / Travel · U05" calledElement="U05_Process_main">
      <bpmn:documentation>Источники: P2234, P2255, P2256. Уровень: подтверждено/следствие. Тот же контекст и chat_id; истечение поиска не прерывает подтверждённую Meeting.</bpmn:documentation>
      <bpmn:documentation>Детализация: U05.bpmn; calledElement разрешён внутри объединённого комплекта. Модель неисполняемая.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_39</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_42</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="U08_activity_community" name="Event / Community · U07" calledElement="U07_Process_main">
      <bpmn:documentation>Источники: P2234, P2254. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:documentation>Детализация: U07.bpmn; calledElement разрешён внутри объединённого комплекта. Модель неисполняемая.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_40</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_43</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="U08_communities" name="P03 собственные / P01 Follow · U07" calledElement="U07_Process_main">
      <bpmn:documentation>Источники: P2214, P2215, P2248, P2249. Уровень: подтверждено/следствие. Не объединять owner, Membership и SocialFollow; P03 max3, P01 feed по ACL.</bpmn:documentation>
      <bpmn:documentation>Детализация: U07.bpmn; calledElement разрешён внутри объединённого комплекта. Модель неисполняемая.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_8</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_44</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="U08_plus" name="Показать P06: $8 / $80, 7 дней и 6 прав">
      <bpmn:documentation>Источники: P2223, T0555. Уровень: подтверждено/следствие. Подключение optional; бесплатное ядро доступно. Trial ровно один раз; отсутствие/требование карты не утверждается. Шесть прав T0555 без рекламы, геопоиска людей и бизнес-прав.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_9</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_45</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="U08_plus_pick" name="Выбрать тариф, trial или отмену продления">
      <bpmn:documentation>Источники: P2224, P0566. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_45</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_46</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U08_plus_route" name="Действие с личным Plus?">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_46</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_47</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_48</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U08_grant" name="Проверить trial / оплату и личный entitlement">
      <bpmn:documentation>Источники: P2224, P2428, T2420. Уровень: подтверждено/следствие. Trial 7 дней однократно; месяц $8, год $80. Платные права только после подтверждения провайдера, без дубля платежа. Раздельно от Gold/Premium; не открывает бизнес-редактор.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_47</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_50</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U08_cancel_renew" name="Отменить автопродление; сохранить период">
      <bpmn:documentation>Источники: P1120, P2224. Уровень: подтверждено/следствие. До paidUntil права активного периода сохраняются; отмена автопродления не означает немедленное лишение Plus.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_48</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_51</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U08_logout" name="Завершить только текущий сеанс">
      <bpmn:documentation>Источники: P2016, P2214. Уровень: подтверждено/следствие. Выход не удаляет Profile, Community, медиа или историю.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_10</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_52</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="U08_logged_out" name="Сеанс завершён">
      <bpmn:documentation>Источники: P2016. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_58</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="U08_delete_confirm" name="Отдельно подтвердить удаление аккаунта">
      <bpmn:documentation>Источники: P2016, P2424, T0875. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_11</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_53</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U08_delete_choice" name="Удаление подтверждено?">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_53</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_54</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_55</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U08_delete" name="Проверить и выполнить согласованное удаление">
      <bpmn:documentation>Источники: P2424, P2426, T0875. Уровень: подтверждено; регламент открыт. Только согласованный lifecycle. Регламент ещё не подготовлен: при отсутствии согласованного действия результат — блокировка/уточнение, не выдуманный каскад удаления данных.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_54</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_56</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U08_result" name="Действие подтверждено сервером?">
      <bpmn:documentation>Источники: P2424, P2428. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_15</bpmn:incoming>
      <bpmn:incoming>U08_Flow_50</bpmn:incoming>
      <bpmn:incoming>U08_Flow_51</bpmn:incoming>
      <bpmn:incoming>U08_Flow_52</bpmn:incoming>
      <bpmn:incoming>U08_Flow_56</bpmn:incoming>
      <bpmn:incoming>U08_Flow_64</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_57</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_58</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_59</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U08_success" name="Показать подтверждённый статус и те же ID">
      <bpmn:documentation>Источники: P2166, P2427. Уровень: подтверждено/следствие. Если повторяется Message — Sent только после его ack; не смешивать успех оплаты с отменой продления или удалением.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_57</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_60</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U08_error" name="Показать причину; сохранить исходные данные">
      <bpmn:documentation>Источники: P2165, P2428. Уровень: подтверждено/следствие. Нет ложного успеха; бесплатные разрешённые функции не блокируются из-за оплаты.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_24</bpmn:incoming>
      <bpmn:incoming>U08_Flow_59</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_61</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U08_retry_choice" name="Повторить команду или вернуться?">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U08_Flow_33</bpmn:incoming>
      <bpmn:incoming>U08_Flow_61</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_62</bpmn:outgoing>
      <bpmn:outgoing>U08_Flow_63</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U08_retry" name="Повторить идемпотентно с проверкой ACL">
      <bpmn:documentation>Источники: P2426, P2428. Уровень: подтверждено/следствие. Сохранённые target ID и тип операции; для Message сохранить draft и дождаться ack, для оплаты не создавать второй платёж.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_62</bpmn:incoming>
      <bpmn:outgoing>U08_Flow_64</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U08_restore" name="Вернуть источник, таб, фильтр и позицию">
      <bpmn:documentation>Источники: P2164, P2422. Уровень: подтверждено/следствие. Прямой чат возвращает в U05/U07; просмотр не продлевает TTL. При недоступном объекте показать актуальное состояние.</bpmn:documentation>
      <bpmn:incoming>U08_Flow_14</bpmn:incoming>
