    <bpmn:sequenceFlow id="U06_Flow_25" sourceRef="U06_permission_denied" targetRef="U06_end"/>
    <bpmn:sequenceFlow id="U06_Flow_26" sourceRef="U06_capture_kind" targetRef="U06_capture" name="Фото / видео"/>
    <bpmn:sequenceFlow id="U06_Flow_27" sourceRef="U06_capture_kind" targetRef="U06_live_setup" name="Разрешённый эфир"/>
    <bpmn:sequenceFlow id="U06_Flow_28" sourceRef="U06_capture" targetRef="U06_preview"/>
