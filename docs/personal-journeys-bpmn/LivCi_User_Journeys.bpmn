      <bpmn:lane id="U05_Lane_main_2" name="Server · Сервер LivCi">
        <bpmn:flowNodeRef>U05_create_context</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_create_ack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_cancel_command</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_cancel_ack</bpmn:flowNodeRef>
