    <bpmn:sequenceFlow id="U05_Flow_32" sourceRef="U05_status" targetRef="U05_chat" name="ACCEPTED"/>
    <bpmn:sequenceFlow id="U05_Flow_33" sourceRef="U05_status" targetRef="U05_ack_error" name="Состояние не получено"/>
    <bpmn:sequenceFlow id="U05_Flow_34" sourceRef="U05_waitlist" targetRef="U05_offer_choice"/>
