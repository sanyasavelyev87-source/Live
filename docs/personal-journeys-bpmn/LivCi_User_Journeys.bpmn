    </bpmn:laneSet>
    <bpmn:startEvent id="U05_start" name="Открыта возможность или своя заявка">
      <bpmn:documentation>Источники: P2184, P2199. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:outgoing>U05_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="U05_choose" name="Выбрать Signal / Moment / Event">
      <bpmn:documentation>Источники: P0125, P0295, T0301, P2184, P2185. Уровень: подтверждено. Формат и Intent независимы; обязательные фильтры применяются в своём сценарии. Это не каталог анкет поблизости.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_0</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U05_request_choice" name="Что хочет пользователь?">
      <bpmn:documentation>Источники: P0311, P0313, P2184, P2164, P2428. Уровень: инженерное уточнение. Статус существующей заявки читается без повторной отправки.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_1</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U05_create_form" name="P13: подтвердить свой Signal / Moment">
      <bpmn:documentation>Источники: P0125, P0295, T0301, P2184, P2185, P2316. Уровень: подтверждено. Выбрать формат и Intent независимо, заполнить обязательные фильтры сценария. Для Signal контекстно запросить недостающее геоправо; отказ не блокирует приложение. Moment описывает конкретную активность. Только явное подтверждение создаёт объект.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_2</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="U05_create_context" name="Проверить условия и создать свой запрос">
      <bpmn:documentation>Источники: P0149, P0247, T0309, P0311, P2426, P2428. Уровень: подтверждено. Атомарно и идемпотентно. Signal: реальная разрешённая геопозиция, 1,5 км, максимум один активный Signal, TTL 15 мин. Moment: набор 90 мин, вместимость включает автора. Отказ геоправ/недопуск не создаёт полчерновика.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_7</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U05_create_ack" name="Создание подтверждено сервером?">
      <bpmn:documentation>Источники: P2426, P2428, P2451. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_8</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_9</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="U05_created_end" name="Свой Signal / Moment создан">
      <bpmn:documentation>Источники: P0311, P0312, P0149, P2451. Уровень: подтверждено. Только созданный запрос, не ACCEPTED и не автоматический чат. Ответы других пользователей и решения автора — последующие явные действия в том же контексте.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="U05_without_request" name="Просмотр завершён без нового запроса">
      <bpmn:documentation>Источники: P0313, P2184. Уровень: инженерное уточнение. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="U05_send" name="Подтвердить отклик / заявку">
      <bpmn:documentation>Источники: P0127, P0313, P2199. Уровень: подтверждено. Только явное действие создаёт SignalResponse/Participation. Создание самого Signal/Moment — другая ветвь этого выбора. Для заполненного Event пользователь может явно выбрать лист ожидания вместо гарантированного места.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_3</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="U05_cancel_command" name="Проверить право; отозвать / отменить">
      <bpmn:documentation>Источники: P0313, P0494, P1799, P2426, P2428. Уровень: подтверждено. Явно выбранная отмена: свой непринятый SignalResponse можно отозвать, своё участие Event — отменить, в том числе после принятия. Проверить владельца и актуальное состояние; идемпотентный повтор, не автоматическая отмена по просмотру.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_5</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U05_cancel_ack" name="Отзыв / отмена подтверждены?">
      <bpmn:documentation>Источники: P2426, P2428, P2451. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_19</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_20</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_21</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="U05_cancel_end" name="Свой отзыв / отмена сохранены">
      <bpmn:documentation>Источники: P0313, P0494, P1799, P2451. Уровень: подтверждено. После отмены Event место сначала предлагается подходящему кандидату из листа ожидания, а не произвольно новому участнику.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="U05_eligibility" name="Проверить ACL, TTL, радиус и места">
      <bpmn:documentation>Источники: P0128, P0145, P0247, P2425, P2426. Уровень: подтверждено. Signal: реальная разрешённая геопозиция, 1,5 км, 15 минут. Moment: набор 90 минут; инициатор входит во вместимость. У Event свои сроки/места; отсутствие места не обещает принятие.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_12</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U05_eligible" name="Запрос допустим сейчас?">
      <bpmn:documentation>Источники: P0128, P1799, P2425, P2426. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_13</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_14</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_15</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U05_unavailable" name="Показать причину недоступности">
      <bpmn:documentation>Источники: P2165, P2426. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_10</bpmn:incoming>
      <bpmn:incoming>U05_Flow_16</bpmn:incoming>
      <bpmn:incoming>U05_Flow_21</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="U05_unavailable_end" name="Запрос не принят к обработке">
      <bpmn:documentation>Источники: P2426, P2451. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="U05_persist" name="Атомарно сохранить запрос">
      <bpmn:documentation>Источники: P2425, P2428. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_14</bpmn:incoming>
      <bpmn:incoming>U05_Flow_15</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U05_ack" name="Сохранение подтверждено?">
      <bpmn:documentation>Источники: P2428, P2451. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_18</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_23</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U05_ack_error" name="Ошибка: без ложного успеха">
      <bpmn:documentation>Источники: P2428, P2451. Уровень: подтверждено. Контекст сохраняется. Повтор команды идемпотентен; текущее прохождение не застревает в ожидании.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_11</bpmn:incoming>
      <bpmn:incoming>U05_Flow_22</bpmn:incoming>
      <bpmn:incoming>U05_Flow_24</bpmn:incoming>
      <bpmn:incoming>U05_Flow_33</bpmn:incoming>
      <bpmn:incoming>U05_Flow_40</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="U05_ack_error_end" name="Возврат к сохранённому контексту">
      <bpmn:documentation>Источники: P2164, P2428. Уровень: инженерное уточнение. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="U05_submitted" name="Показать подтверждённую заявку">
      <bpmn:documentation>Источники: P0313, P2199, P2451. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_23</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="U05_read_status" name="Получить актуальное состояние">
      <bpmn:documentation>Источники: P0128, P0314, P0318, P2199, P2426. Уровень: инженерное уточнение. Снимок состояния. Принятие/отклонение — явное решение создателя объекта, другой стороны, а не автоматический результат отправки или чтения. Сервер возвращает это решение. Повторный просмотр не создаёт новую заявку.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_4</bpmn:incoming>
      <bpmn:incoming>U05_Flow_26</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U05_status" name="Состояние запроса?">
      <bpmn:documentation>Источники: P0313, P0314, P0318, P1799, P2199. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_27</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_28</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_29</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_30</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_31</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_32</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="U05_pending_end" name="PENDING: вернуться, статус сохранён">
      <bpmn:documentation>Источники: P0313, P2199, P2164. Уровень: инженерное уточнение. Конец текущего просмотра, а не заявки. Позднее пользователь может открыть существующую заявку или уведомление. Универсальный таймер решения для Event не выдумывается.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="U05_waitlist" name="Event: открыть очередь / ответить на offer">
      <bpmn:documentation>Источники: P0494, P1799, P2046, P2425. Уровень: подтверждено. WAITLISTED не означает место. При освобождении места первый подходящий кандидат получает приглашение на 30 минут. Подтверждение участия — отдельное явное действие кандидата.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_29</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U05_offer_choice" name="Принять доступный offer ≤30 мин?">
      <bpmn:documentation>Источники: P2046, P2425. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_34</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_35</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U05_offer_recheck" name="Перепроверить offer и место атомарно">
      <bpmn:documentation>Источники: P0128, P2046, P2425, P2426, P2428. Уровень: подтверждено. Проверить кандидата, срок, ACL и свободное место при записи. Одновременное подтверждение не допускает переполнения.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_35</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U05_offer_result" name="Участие действительно принято?">
      <bpmn:documentation>Источники: P2425, P2451. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_37</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_38</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_39</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="U05_waitlist_end" name="Без нового места: актуальный статус очереди">
      <bpmn:documentation>Источники: P1799, P2046, P2425. Уровень: инженерное уточнение. Нет offer, отказ, истечение или проигранная гонка не дают ACCEPTED. При неподтверждении за 30 минут предложение переходит следующему. Дальнейший статус очереди — по серверным правилам, без гарантии места или вечного ожидания.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_36</bpmn:incoming>
      <bpmn:incoming>U05_Flow_39</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="U05_rejected" name="Показать отклонение">
      <bpmn:documentation>Источники: P0128, P0314. Уровень: подтверждено. Отказ на SignalResponse не требует объяснения.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_30</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="U05_rejected_end" name="REJECTED: без встречи и нового чата">
      <bpmn:documentation>Источники: P0314, P0315. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_41</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="U05_expired" name="Запрос истёк / отменён">
      <bpmn:documentation>Источники: P0149, P0318, P2165. Уровень: подтверждено. Новые отклики не принимаются. TTL не возрождается повтором.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_31</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="U05_expired_end" name="Текущий непринятый запрос завершён">
      <bpmn:documentation>Источники: P0318, P2441. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_42</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="U05_chat" name="ACCEPTED: открыть тот же chat_id" calledElement="U08_Process_main">
      <bpmn:documentation>Источники: P0129, P0315, P2229, P2230. Уровень: подтверждено. Только разрешённая существующая контекстная беседа. Вызов U08 здесь ограничен открытием chat_id, без автоматического запуска нового социального цикла. Принятый чат/встреча не обрываются от TTL объявления.</bpmn:documentation>
      <bpmn:documentation>Детализация: U08.bpmn; calledElement разрешён внутри объединённого комплекта. Модель неисполняемая.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_32</bpmn:incoming>
      <bpmn:incoming>U05_Flow_38</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_43</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="U05_context" name="Какой источник встречи?">
      <bpmn:documentation>Источники: P0130, P0131, P0132. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_43</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_44</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_45</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_46</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U05_signal_agree" name="Signal: согласовать публичное место">
      <bpmn:documentation>Источники: P0315, P0316. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_44</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_47</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U05_signal_mutual" name="Обе стороны подтвердили?">
      <bpmn:documentation>Источники: P0132, P0316. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_47</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_48</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U05_signal_place" name="Раскрыть согласованное место">
      <bpmn:documentation>Источники: P0316. Уровень: подтверждено. Публичное место встречи, не текущий GPS человека.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_48</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_50</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="U05_signal_unconfirmed" name="Нет взаимности: остаётся принятый чат">
      <bpmn:documentation>Источники: P0315, P0316, P0318. Уровень: инженерное уточнение. Публичное место не раскрывать как подтверждённое. Этот конец не удаляет разрешённую беседу.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_49</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="U05_need_plan" name="Moment: нужно согласование?">
      <bpmn:documentation>Источники: P0130. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_45</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_51</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_52</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U05_plan" name="Согласовать Plan внутри Moment">
      <bpmn:documentation>Источники: P0130, P0663. Уровень: подтверждено. Место, время или условия. Если они уже определены, дополнительная форма не обязательна.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_51</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_53</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="U05_event_place" name="Event: место/время организатора">
      <bpmn:documentation>Источники: P0131, P2199. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_46</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_54</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="U05_coordinated" name="Договорённость доступна">
      <bpmn:documentation>Источники: P0130, P0131, P0316. Уровень: инженерное уточнение. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_50</bpmn:incoming>
      <bpmn:incoming>U05_Flow_52</bpmn:incoming>
      <bpmn:incoming>U05_Flow_53</bpmn:incoming>
      <bpmn:incoming>U05_Flow_54</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_55</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U05_meeting" name="Реальная встреча">
      <bpmn:documentation>Источники: P0133. Уровень: подтверждено. Истечение Signal/Moment не завершает встречу.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_55</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_56</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U05_attendance" name="Участники подтверждают участие">
      <bpmn:documentation>Источники: P0133. Уровень: подтверждено. Неявку конкретного участника вправе отметить только организатор; спорная отметка не влияет до проверки.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_56</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_57</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U05_majority" name="Подтвердили строго &gt; 1/2?">
      <bpmn:documentation>Источники: P0133. Уровень: подтверждено. Не по одному таймеру и не по простому окончанию расписания.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_57</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_58</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_59</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U05_not_completed" name="Нет большинства: не COMPLETED">
      <bpmn:documentation>Источники: P0133, P0134, P0665. Уровень: инженерное уточнение. Meeting не завершать автоматически. Connection опирается на состоявшуюся реальную встречу и взаимность, а не на выдуманную дополнительную предпосылку статуса COMPLETED.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_59</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_60</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="U05_complete" name="Meeting → COMPLETED">
      <bpmn:documentation>Источники: P0133. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_58</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_61</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="U05_connection_intent" name="Выбрать: нужна ли связь после встречи">
      <bpmn:documentation>Источники: P0134, P0665. Уровень: подтверждено. Связь необязательна; тип каждый участник выбирает сам.</bpmn:documentation>
      <bpmn:incoming>U05_Flow_60</bpmn:incoming>
      <bpmn:incoming>U05_Flow_61</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_62</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U05_connection_mutual" name="Оба согласны на Connection?">
      <bpmn:documentation>Источники: P0134, P0665. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_62</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_63</bpmn:outgoing>
      <bpmn:outgoing>U05_Flow_64</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U05_connection" name="Создать взаимный Connection">
      <bpmn:documentation>Источники: P0134, P0665. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_63</bpmn:incoming>
      <bpmn:outgoing>U05_Flow_65</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="U05_connected" name="Связь создана после встречи">
      <bpmn:documentation>Источники: P0134, P0665. Уровень: подтверждено. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_65</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="U05_without_connection" name="Без Connection; встреча сохранена">
      <bpmn:documentation>Источники: P0134, P0665. Уровень: инженерное уточнение. </bpmn:documentation>
      <bpmn:incoming>U05_Flow_64</bpmn:incoming>
    </bpmn:endEvent>
