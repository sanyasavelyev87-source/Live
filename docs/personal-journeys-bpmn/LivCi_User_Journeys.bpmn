    <bpmn:sequenceFlow id="U06_Flow_34" sourceRef="U06_valid" targetRef="U06_command" name="Да: права и данные допустимы"/>
    <bpmn:sequenceFlow id="U06_Flow_35" sourceRef="U06_valid" targetRef="U06_invalid" name="Нет: понятный отказ"/>
    <bpmn:sequenceFlow id="U06_Flow_36" sourceRef="U06_invalid" targetRef="U06_end"/>
