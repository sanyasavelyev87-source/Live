      <bpmn:incoming>U07_Flow_43</bpmn:incoming>
      <bpmn:incoming>U07_Flow_46</bpmn:incoming>
      <bpmn:incoming>U07_Flow_51</bpmn:incoming>
      <bpmn:incoming>U07_Flow_55</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_57</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="U07_end" name="Контекст восстановлен">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_57</bpmn:incoming>
    </bpmn:endEvent>
