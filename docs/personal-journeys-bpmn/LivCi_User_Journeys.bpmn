      <bpmn:incoming>U03_Flow_6</bpmn:incoming>
      <bpmn:outgoing>U03_Flow_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="U03_profile" name="Профиль · P07 / U08" calledElement="U08_Process_main">
      <bpmn:documentation>Детализация: U08.bpmn; calledElement разрешён внутри объединённого комплекта. Модель неисполняемая.</bpmn:documentation>
      <bpmn:incoming>U03_Flow_8</bpmn:incoming>
      <bpmn:outgoing>U03_Flow_9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="U03_state" name="Отобразить фактический результат / пусто / ошибку">
