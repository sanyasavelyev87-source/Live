  <bpmn:process id="U03_Process_main" isExecutable="false">
    <bpmn:documentation>Пять направлений личного аккаунта. Создать — действие, а не обычная лента. Выборы на шлюзах описывают намерение пользователя и не вводят новые диалоги. Источники DOCX: P2162, P2163, P2164, P2165, P2422, P2427. Референсы: UR15, UR14, UR12, UR11, UR08. Рабочая модель пути, не исполнение backend.</bpmn:documentation>
    <bpmn:laneSet id="U03_LaneSet_main">
      <bpmn:lane id="U03_Lane_main_0" name="Пользователь · действие и выбор">
        <bpmn:flowNodeRef>U03_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U03_nav</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U03_next</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U03_Lane_main_1" name="Приложение LivCi · экран и контекст">
        <bpmn:flowNodeRef>U03_snapshot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U03_map</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U03_people</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U03_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U03_communities</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U03_profile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U03_state</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U03_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U03_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U03_Lane_main_2" name="LivCi · сервер, данные и права"/>
    </bpmn:laneSet>
    <bpmn:startEvent id="U03_s" name="Карта / текущий разрешённый экран">
      <bpmn:outgoing>U03_Flow_10</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="U03_snapshot" name="Запомнить экран, вкладку, фильтры, скролл и объект">
      <bpmn:incoming>U03_Flow_10</bpmn:incoming>
      <bpmn:incoming>U03_Flow_13</bpmn:incoming>
      <bpmn:outgoing>U03_Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
