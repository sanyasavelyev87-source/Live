    <bpmn:sequenceFlow id="U05_Flow_48" sourceRef="U05_signal_mutual" targetRef="U05_signal_place" name="Да: взаимное подтверждение"/>
    <bpmn:sequenceFlow id="U05_Flow_49" sourceRef="U05_signal_mutual" targetRef="U05_signal_unconfirmed" name="Нет / ещё не подтверждено"/>
