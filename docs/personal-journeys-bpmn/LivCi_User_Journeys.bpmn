    <bpmn:sequenceFlow id="U03_Flow_11" sourceRef="U03_snapshot" targetRef="U03_nav"/>
    <bpmn:sequenceFlow id="U03_Flow_12" sourceRef="U03_state" targetRef="U03_next"/>
    <bpmn:sequenceFlow id="U03_Flow_13" sourceRef="U03_next" targetRef="U03_snapshot" name="Другой раздел / действие"/>
