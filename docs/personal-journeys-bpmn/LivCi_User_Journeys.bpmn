        <bpmn:flowNodeRef>U05_offer_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_signal_agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_need_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_attendance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U05_connection_intent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U05_Lane_main_1" name="Client · Приложение LivCi">
