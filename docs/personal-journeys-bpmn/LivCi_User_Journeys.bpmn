    <bpmn:sequenceFlow id="U06_Flow_48" sourceRef="U06_result_kind" targetRef="U06_live_end" name="Эфир уже завершён при сверке"/>
    <bpmn:sequenceFlow id="U06_Flow_49" sourceRef="U06_result_kind" targetRef="U06_published" name="Кружок / Travel сохранён"/>
    <bpmn:sequenceFlow id="U06_Flow_50" sourceRef="U06_live" targetRef="U06_live_end"/>
    <bpmn:sequenceFlow id="U06_Flow_51" sourceRef="U06_live_end" targetRef="U06_end"/>
    <bpmn:sequenceFlow id="U06_Flow_52" sourceRef="U06_published" targetRef="U06_end"/>
  </bpmn:process>
  <bpmn:collaboration id="U06_Collaboration">
    <bpmn:participant id="U06_Participant_main" name="U06 · Создать: видео / фото / эфир / Travel" processRef="U06_Process_main"/>
  </bpmn:collaboration>
  <bpmn:process id="U07_Process_main" isExecutable="false">
    <bpmn:documentation>Вход из P10/P09/P08, карточки карты U04 либо вложенных P01/P03 профиля U08. Один проход выполняет выбранное действие и возвращает источник с прежними вкладкой, фильтром и прокруткой. P10/P09/P08 показывают актуальные разрешённые Community/Event/Reel. P03 содержит только Community с owner_user_id текущего пользователя, максимум три; сервер атомарно проверяет лимит и capability. SocialFollow.targetCommunityId ссылается на Community; Venue связан с бизнес-Community. Follow, Membership и владение независимы. P01 Подписки показывает follows, Мои заведения — связанные Venue; Рилсы — только разрешённые Reel follow-набора. Рекомендация не Follow. UNFOLLOW убирает объект из персонального фида, не удаляет Reel, Membership, owner-роль или публичный каталог. Event отклик проверяет место атомарно, включая инициатора; полный состав/лист ожидания не изображается подтверждённым участием. Предложение места из waitlist подтверждается за 30 минут. P09 Билеты — демонстрационная кнопка: продажи билетов и платёжной интеграции этот процесс не вводит. Reel не Circle, у него нет автоматического маркера или TTL 90 минут. Удаление Community допускается после подтверждения и по согласованному lifecycle; судьба прошлых медиа/чатов открыта, каскады не придуманы. Каждое чтение/запись проверяет session/ACL/TTL/capability; показ ошибки/пустого списка не выдаёт закрытые данные. До серверного подтверждения вступление, подписка, создание или удаление не завершены. Источники DOCX: P1083, P1084, P1085, P1089, P1090, P1091, P1095, P1096, P1097, P1137, P1138, P1139, P1143, P1144, P1145, P2164, P2193, P2194, P2195, P2198, P2199, P2200, P2203, P2204, P2205, P2238, P2239, P2240, P2243, P2244, P2245, P2248, P2249, P2250, P2251, P2258, P2422, P2423, P2424, P2425, P2426, P2428, P2439, P2440, T2420, T2435. Референсы: UR11, UR10, UR09, UR04, UR02. Рабочая модель пути, не исполнение backend.</bpmn:documentation>
    <bpmn:laneSet id="U07_LaneSet_main">
      <bpmn:lane id="U07_Lane_main_0" name="User">
        <bpmn:flowNodeRef>U07_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_choose_catalog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_catalog_route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_choose_follow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_follow_route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_choose_own</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_own_route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_confirm_delete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_delete_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_retry_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U07_Lane_main_1" name="Client">
        <bpmn:flowNodeRef>U07_context</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_catalog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_catalog_state</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_read_map</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_follow_view</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_own_view</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_limit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_preview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_sync</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_retry_route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_restore</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="U07_Lane_main_2" name="Server">
        <bpmn:flowNodeRef>U07_access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_authorized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_membership</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_reel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_follow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_unfollow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_feed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_create_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_manage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_delete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U07_retry</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="U07_start" name="Вход в сообщества">
      <bpmn:documentation>Источники: P2192, P2197, P2202, P2242, P2237. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:outgoing>U07_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="U07_context" name="Сохранить источник и выбранное действие">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. Прямые входы P01/P03/карточки не требуют предварительного посещения каталога.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_0</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U07_access" name="Проверить сессию, ACL и актуальность">
      <bpmn:documentation>Источники: P2422, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_1</bpmn:incoming>
      <bpmn:incoming>U07_Flow_10</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U07_authorized" name="Доступ разрешён?">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_2</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="U07_route" name="Какой контекст выбран?">
      <bpmn:documentation>Источники: T2435. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_3</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U07_catalog" name="Показать P10 / P09 / P08 и фильтры">
      <bpmn:documentation>Источники: P2193, P2198, P2203. Уровень: подтверждено/следствие. Категории/табы внутри Сообществ. Карточки используют исходные ID; пустой список и ошибка отличаются. Билеты на P09 не запускают покупку.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_5</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U07_catalog_state" name="Состояние каталога и действие?">
      <bpmn:documentation>Источники: P2165, P2206. Уровень: подтверждено/следствие. Пустой список/ошибка/скрытые объекты не требуют выбора несуществующей карточки. Повтор чтения заново проверяет доступ и не повторяет команду записи.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_8</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_9</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U07_choose_catalog" name="Выбрать объект или разрешённое действие">
      <bpmn:documentation>Источники: P2194, P2199, P2204. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_9</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U07_catalog_route" name="Действие каталога?">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_12</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_13</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_14</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_15</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_16</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="U07_read_map" name="Просмотр объекта на карте · U04" calledElement="U04_Process_main">
      <bpmn:documentation>Источники: P1060, P2174, P2422. Уровень: подтверждено/следствие. Из разрешённой карточки; отсутствие живого маркера не возрождает TTL. Чтение самой Community/Event/Reel остаётся в исходном контексте.</bpmn:documentation>
      <bpmn:documentation>Детализация: U04.bpmn; calledElement разрешён внутри объединённого комплекта. Модель неисполняемая.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_13</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_18</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="U07_membership" name="Проверить и записать Membership / заявку">
      <bpmn:documentation>Источники: P1084, P2194, P2195, P2423. Уровень: подтверждено/следствие. По типу доступа: членство либо ожидающая заявка; Follow и owner-роль не назначаются.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_15</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U07_event" name="Проверить место и записать Participation">
      <bpmn:documentation>Источники: P1090, P2199, P2425, T2435. Уровень: подтверждено/следствие. Атомарный guard вместимости с инициатором; показать принятый/ожидающий/отказанный статус. Разрешённый Event chat использует тот же chat_id. При waitlist 30 минут на подтверждение предложенного места. Событие не получает постоянный маркер; Билеты не реализуют продажу.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_16</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U07_reel" name="Выдать Reel; проверить лайк / комментарий / share">
      <bpmn:documentation>Источники: P1096, P1097, P2204, P2205. Уровень: подтверждено/следствие. Разрешённый просмотр/Like/комментарий; share — deep link с ACL. Авторство ведёт в ту же Community/разрешённый Profile; TTL Circle не применяется.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_17</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U07_follow_view" name="Открыть P01 или Follow из карточки">
      <bpmn:documentation>Источники: P1143, P2243, P2423. Уровень: подтверждено/следствие. Подписки / Рилсы; Мои комьюнити / Мои заведения / рекомендации. Смотреть все раскрывает полный разрешённый список; рекомендации ещё не подписаны.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_6</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="U07_choose_follow" name="Выбрать Follow, Unfollow или фид">
      <bpmn:documentation>Источники: P2244, P2245. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_22</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U07_follow_route" name="Действие социальной подписки?">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_23</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_24</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_25</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_26</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U07_follow" name="Создать Follow на targetCommunityId">
      <bpmn:documentation>Источники: P2249, P2423, P2428. Уровень: подтверждено/следствие. Venue подписывается через связанную бизнес-Community. Бесплатное социальное действие не назначает Membership/owner и не покупает Plus.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_24</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U07_unfollow" name="Удалить только связь Follow">
      <bpmn:documentation>Источники: P2245, P2258, P2424, P2440. Уровень: подтверждено/следствие. Убрать из персонального feed; не удалить Reel, Membership, владение или запись публичного каталога.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_25</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U07_feed" name="Выдать только разрешённые Reel follow-набора">
      <bpmn:documentation>Источники: P2244, P2249, P2258, P2423. Уровень: подтверждено/следствие. Для неподписанной рекомендации чужие Reel не подмешиваются как follow feed.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_26</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U07_own_view" name="Открыть P03: только собственные Community">
      <bpmn:documentation>Источники: P2238, P2248. Уровень: подтверждено/следствие. owner_user_id текущего пользователя, счётчик до 3; членство в чужом сообществе не расходует лимит.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_7</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="U07_choose_own" name="Выбрать создать, управлять, открыть или удалить">
      <bpmn:documentation>Источники: P2239. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_31</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U07_own_route" name="Действие собственного Community?">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_32</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_33</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_34</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_35</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_36</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U07_create" name="Атомарно проверить &lt; 3 и создать Community">
      <bpmn:documentation>Источники: P2250, P2439, P2428. Уровень: подтверждено/следствие. Guard и запись в одной атомарной операции. При 3/3 четвёртая запись не создаётся, даже если кнопка на референсе активна.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_33</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U07_create_result" name="Создание подтверждено?">
      <bpmn:documentation>Источники: P2240, P2250. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_38</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_39</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U07_limit" name="Показать лимит 3/3 или причину отказа">
      <bpmn:documentation>Источники: P2240, P2250. Уровень: подтверждено/следствие. Не предлагать скрытую покупку лимита; при технической ошибке сохранить форму и разрешить безопасный повтор из источника.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_40</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_41</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U07_manage" name="Проверить owner/capability и открыть управление">
      <bpmn:documentation>Источники: P2239, P2248, P2426. Уровень: подтверждено/следствие. Управление только конкретным community_id; личные права не становятся бизнес-правами.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_34</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_42</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U07_preview" name="Открыть публичный вид того же community_id">
      <bpmn:documentation>Источники: P2239, P2248. Уровень: подтверждено/следствие. Данные ограничены текущими правами, копия Community не создаётся.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_35</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_43</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="U07_confirm_delete" name="Подтвердить удаление Community">
      <bpmn:documentation>Источники: P2251, P2424. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_36</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_44</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U07_delete_choice" name="Удаление подтверждено?">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_44</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_45</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_46</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U07_delete" name="Выполнить разрешённое удаление по lifecycle">
      <bpmn:documentation>Источники: P2251, P2424, P2426. Уровень: подтверждено; lifecycle частично открыт. Выполнять только согласованные последствия удаления. Если регламент для данных не определён, показать блокирующее уточнение; не стирать автоматически старые медиа/чаты и бизнес-объекты.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_45</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_47</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U07_merge" name="Результат выбранного действия">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_19</bpmn:incoming>
      <bpmn:incoming>U07_Flow_20</bpmn:incoming>
      <bpmn:incoming>U07_Flow_21</bpmn:incoming>
      <bpmn:incoming>U07_Flow_28</bpmn:incoming>
      <bpmn:incoming>U07_Flow_29</bpmn:incoming>
      <bpmn:incoming>U07_Flow_30</bpmn:incoming>
      <bpmn:incoming>U07_Flow_39</bpmn:incoming>
      <bpmn:incoming>U07_Flow_42</bpmn:incoming>
      <bpmn:incoming>U07_Flow_47</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_48</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="U07_result" name="Сервер подтвердил результат?">
      <bpmn:documentation>Источники: P2206, P2241, P2246, P2428. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_48</bpmn:incoming>
      <bpmn:incoming>U07_Flow_56</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_49</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_50</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U07_sync" name="Показать статус; синхронизировать те же ID">
      <bpmn:documentation>Источники: P2166, P2427. Уровень: подтверждено/следствие. Ожидающая заявка не отображается уже принятым членством/участием.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_49</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_51</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U07_error" name="Показать отказ / ошибку без ложного успеха">
      <bpmn:documentation>Источники: P2165, P2246, P2424, P2428. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_4</bpmn:incoming>
      <bpmn:incoming>U07_Flow_50</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_52</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="U07_retry_choice" name="Выбрать повтор или возврат">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_52</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_53</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U07_retry_route" name="Повторить сохранённую команду?">
      <bpmn:documentation>Источники: P2164, P2426. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U07_Flow_53</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_54</bpmn:outgoing>
      <bpmn:outgoing>U07_Flow_55</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U07_retry" name="Повторить идемпотентно с новыми ACL">
      <bpmn:documentation>Источники: P2426, P2428. Уровень: подтверждено/следствие. Сохранённый тип команды и target ID; нет дубля Follow/Participation/Community. Неподтверждённое удаление не выполняется.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_54</bpmn:incoming>
      <bpmn:outgoing>U07_Flow_56</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="U07_restore" name="Вернуть источник, вкладку и позицию">
      <bpmn:documentation>Источники: P2164, P2422. Уровень: подтверждено/следствие. При отказе не показывать закрытые данные; техническая ошибка создания сохраняет форму для повтора.</bpmn:documentation>
      <bpmn:incoming>U07_Flow_11</bpmn:incoming>
      <bpmn:incoming>U07_Flow_14</bpmn:incoming>
      <bpmn:incoming>U07_Flow_18</bpmn:incoming>
      <bpmn:incoming>U07_Flow_27</bpmn:incoming>
      <bpmn:incoming>U07_Flow_37</bpmn:incoming>
