      <bpmn:incoming>U03_Flow_1</bpmn:incoming>
      <bpmn:incoming>U03_Flow_3</bpmn:incoming>
      <bpmn:incoming>U03_Flow_5</bpmn:incoming>
      <bpmn:incoming>U03_Flow_7</bpmn:incoming>
      <bpmn:incoming>U03_Flow_9</bpmn:incoming>
      <bpmn:outgoing>U03_Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="U03_next" name="Следующее действие?">
      <bpmn:incoming>U03_Flow_12</bpmn:incoming>
      <bpmn:outgoing>U03_Flow_13</bpmn:outgoing>
      <bpmn:outgoing>U03_Flow_14</bpmn:outgoing>
      <bpmn:outgoing>U03_Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="U03_back" name="Назад / X · восстановить источник и актуальные данные">
      <bpmn:documentation>Источники: P2164, P2422. Уровень: подтверждено/следствие. </bpmn:documentation>
      <bpmn:incoming>U03_Flow_14</bpmn:incoming>
      <bpmn:outgoing>U03_Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="U03_end" name="Контекст сохранён · пользователь продолжает">
      <bpmn:incoming>U03_Flow_15</bpmn:incoming>
      <bpmn:incoming>U03_Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="U03_Flow_0" sourceRef="U03_nav" targetRef="U03_map" name="Карта"/>
