        <bpmn:flowNodeRef>B04_media</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B04_visibility</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B04_Lane_main_1" name="LivCi · серверные проверки и данные">
        <bpmn:flowNodeRef>B04_access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B04_upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B04_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B04_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B04_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B04_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="B04_s" name="Открыт раздел содержимого">
      <bpmn:outgoing>B04_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="B04_access" name="Проверить право на раздел и действие">
      <bpmn:incoming>B04_Flow_0</bpmn:incoming>
      <bpmn:outgoing>B04_Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
