  </bpmn:collaboration>
  <bpmn:process id="B05_Process_main" isExecutable="false">
    <bpmn:documentation>Событие имеет собственные дату, лимит, участников и контекст чата. Подпись в публикации не создаёт событие автоматически. Источники: BR10. Рабочая спецификация, не модель исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="B05_LaneSet_main">
      <bpmn:lane id="B05_Lane_main_0" name="Представитель бизнеса · выданные права">
        <bpmn:flowNodeRef>B05_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B05_edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B05_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B05_accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B05_Lane_main_1" name="LivCi · серверные проверки и данные">
        <bpmn:flowNodeRef>B05_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B05_surface</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B05_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B05_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B05_capacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B05_member</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B05_waitlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B05_reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B05_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="B05_s" name="Создать / открыть событие">
      <bpmn:outgoing>B05_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="B05_edit" name="Указать название, время, описание, место и условия">
      <bpmn:incoming>B05_Flow_0</bpmn:incoming>
      <bpmn:outgoing>B05_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="B05_save" name="Проверить права и сохранить Event">
      <bpmn:incoming>B05_Flow_1</bpmn:incoming>
      <bpmn:outgoing>B05_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B05_surface" name="Опубликовать в разделе событий; проверить карту">
      <bpmn:incoming>B05_Flow_2</bpmn:incoming>
      <bpmn:outgoing>B05_Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="B05_request" name="Получена заявка на участие">
      <bpmn:incoming>B05_Flow_3</bpmn:incoming>
      <bpmn:outgoing>B05_Flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B05_request_Message"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="B05_check" name="Проверить доступ, повтор заявки и свободные места">
      <bpmn:incoming>B05_Flow_4</bpmn:incoming>
      <bpmn:outgoing>B05_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B05_capacity" name="Есть место и выполнены условия?">
      <bpmn:incoming>B05_Flow_5</bpmn:incoming>
      <bpmn:outgoing>B05_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>B05_Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B05_decision" name="Рассмотреть заявку при требуемом согласовании">
      <bpmn:incoming>B05_Flow_8</bpmn:incoming>
      <bpmn:outgoing>B05_Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="B05_accept" name="Решение?">
      <bpmn:incoming>B05_Flow_9</bpmn:incoming>
      <bpmn:outgoing>B05_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>B05_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B05_member" name="Зафиксировать участие и доступ к чату события">
      <bpmn:incoming>B05_Flow_10</bpmn:incoming>
      <bpmn:outgoing>B05_Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B05_waitlist" name="Лист ожидания / отказ согласно правилам Event">
      <bpmn:incoming>B05_Flow_11</bpmn:incoming>
      <bpmn:incoming>B05_Flow_12</bpmn:incoming>
      <bpmn:outgoing>B05_Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="B05_reply" name="Сообщить статус участия">
      <bpmn:incoming>B05_Flow_13</bpmn:incoming>
      <bpmn:incoming>B05_Flow_14</bpmn:incoming>
      <bpmn:outgoing>B05_Flow_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="B05_e" name="Статусы, счётчики и чат согласованы">
      <bpmn:incoming>B05_Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B05_Flow_0" sourceRef="B05_s" targetRef="B05_edit"/>
    <bpmn:sequenceFlow id="B05_Flow_1" sourceRef="B05_edit" targetRef="B05_save"/>
    <bpmn:sequenceFlow id="B05_Flow_2" sourceRef="B05_save" targetRef="B05_surface"/>
    <bpmn:sequenceFlow id="B05_Flow_3" sourceRef="B05_surface" targetRef="B05_request"/>
    <bpmn:sequenceFlow id="B05_Flow_4" sourceRef="B05_request" targetRef="B05_check"/>
    <bpmn:sequenceFlow id="B05_Flow_5" sourceRef="B05_check" targetRef="B05_capacity"/>
    <bpmn:sequenceFlow id="B05_Flow_8" sourceRef="B05_capacity" targetRef="B05_decision" name="Да"/>
    <bpmn:sequenceFlow id="B05_Flow_9" sourceRef="B05_decision" targetRef="B05_accept"/>
    <bpmn:sequenceFlow id="B05_Flow_10" sourceRef="B05_accept" targetRef="B05_member" name="Принято / свободное участие"/>
    <bpmn:sequenceFlow id="B05_Flow_11" sourceRef="B05_accept" targetRef="B05_waitlist" name="Отклонено"/>
    <bpmn:sequenceFlow id="B05_Flow_12" sourceRef="B05_capacity" targetRef="B05_waitlist" name="Нет"/>
    <bpmn:sequenceFlow id="B05_Flow_13" sourceRef="B05_waitlist" targetRef="B05_reply"/>
    <bpmn:sequenceFlow id="B05_Flow_14" sourceRef="B05_member" targetRef="B05_reply"/>
    <bpmn:sequenceFlow id="B05_Flow_15" sourceRef="B05_reply" targetRef="B05_e"/>
  </bpmn:process>
  <bpmn:collaboration id="B05_Collaboration">
    <bpmn:participant id="B05_Participant_main" name="События: публикация, заявки, участие и чат" processRef="B05_Process_main"/>
    <bpmn:participant id="B05_Participant_visitor" name="Обычный пользователь: просмотр и заявка"/>
    <bpmn:messageFlow id="B05_Flow_6" name="Доступное событие" sourceRef="B05_surface" targetRef="B05_Participant_visitor"/>
    <bpmn:messageFlow id="B05_Flow_7" name="Заявка с event_id" sourceRef="B05_Participant_visitor" targetRef="B05_request"/>
    <bpmn:messageFlow id="B05_Flow_16" name="Текущий статус, не бронь/билет" sourceRef="B05_reply" targetRef="B05_Participant_visitor"/>
  </bpmn:collaboration>
  <bpmn:process id="B06_Process_main" isExecutable="false">
    <bpmn:documentation>Членство, подписка на уведомления и административные права — разные разрешения. Внутренний чат команды не становится публичным. Источники: BR06, BR09, BR10. Рабочая спецификация, не модель исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="B06_LaneSet_main">
      <bpmn:lane id="B06_Lane_main_0" name="Представитель бизнеса · выданные права">
        <bpmn:flowNodeRef>B06_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B06_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B06_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B06_chat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B06_Lane_main_1" name="LivCi · серверные проверки и данные">
        <bpmn:flowNodeRef>B06_identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B06_path</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B06_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B06_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B06_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B06_rights</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B06_allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B06_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B06_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B06_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="B06_s" name="Запрос вступления / открытие чата">
      <bpmn:outgoing>B06_Flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B06_s_Message"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="B06_identify" name="Определить Community и права пользователя">
      <bpmn:incoming>B06_Flow_0</bpmn:incoming>
      <bpmn:outgoing>B06_Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B06_path" name="Открытое или закрытое Community?">
      <bpmn:incoming>B06_Flow_1</bpmn:incoming>
      <bpmn:outgoing>B06_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>B06_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>B06_Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B06_pending" name="Сохранить заявку без доступа к закрытому">
      <bpmn:incoming>B06_Flow_2</bpmn:incoming>
      <bpmn:outgoing>B06_Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="B06_review" name="Уполномоченный сотрудник рассматривает заявку">
      <bpmn:incoming>B06_Flow_3</bpmn:incoming>
      <bpmn:outgoing>B06_Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="B06_decision" name="Принять?">
      <bpmn:incoming>B06_Flow_4</bpmn:incoming>
      <bpmn:outgoing>B06_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>B06_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B06_reject" name="Сохранить отказ; доступ не выдавать">
      <bpmn:incoming>B06_Flow_5</bpmn:incoming>
      <bpmn:outgoing>B06_Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B06_join" name="Сохранить членство; обновить список">
      <bpmn:incoming>B06_Flow_7</bpmn:incoming>
      <bpmn:incoming>B06_Flow_8</bpmn:incoming>
      <bpmn:outgoing>B06_Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="B06_chat" name="Выбрать конкретный чат Community или Event">
      <bpmn:incoming>B06_Flow_9</bpmn:incoming>
      <bpmn:incoming>B06_Flow_10</bpmn:incoming>
      <bpmn:outgoing>B06_Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="B06_rights" name="Проверить участие, видимость и право чтения/отправки">
      <bpmn:incoming>B06_Flow_11</bpmn:incoming>
      <bpmn:outgoing>B06_Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B06_allowed" name="Доступ есть?">
      <bpmn:incoming>B06_Flow_12</bpmn:incoming>
      <bpmn:outgoing>B06_Flow_13</bpmn:outgoing>
      <bpmn:outgoing>B06_Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B06_send" name="Открыть историю / сохранить сообщение">
      <bpmn:incoming>B06_Flow_13</bpmn:incoming>
      <bpmn:outgoing>B06_Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B06_deny" name="Показать ограничение без чужих сообщений">
      <bpmn:incoming>B06_Flow_14</bpmn:incoming>
      <bpmn:outgoing>B06_Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B06_e" name="Пользователь получил только разрешённый результат">
      <bpmn:incoming>B06_Flow_6</bpmn:incoming>
      <bpmn:incoming>B06_Flow_15</bpmn:incoming>
      <bpmn:incoming>B06_Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B06_Flow_0" sourceRef="B06_s" targetRef="B06_identify"/>
    <bpmn:sequenceFlow id="B06_Flow_1" sourceRef="B06_identify" targetRef="B06_path"/>
    <bpmn:sequenceFlow id="B06_Flow_2" sourceRef="B06_path" targetRef="B06_pending" name="Закрытое; не участник"/>
    <bpmn:sequenceFlow id="B06_Flow_3" sourceRef="B06_pending" targetRef="B06_review"/>
    <bpmn:sequenceFlow id="B06_Flow_4" sourceRef="B06_review" targetRef="B06_decision"/>
    <bpmn:sequenceFlow id="B06_Flow_5" sourceRef="B06_decision" targetRef="B06_reject" name="Нет"/>
    <bpmn:sequenceFlow id="B06_Flow_6" sourceRef="B06_reject" targetRef="B06_e"/>
    <bpmn:sequenceFlow id="B06_Flow_7" sourceRef="B06_decision" targetRef="B06_join" name="Да"/>
    <bpmn:sequenceFlow id="B06_Flow_8" sourceRef="B06_path" targetRef="B06_join" name="Открытое: допустимо вступление"/>
    <bpmn:sequenceFlow id="B06_Flow_9" sourceRef="B06_path" targetRef="B06_chat" name="Уже есть членство"/>
    <bpmn:sequenceFlow id="B06_Flow_10" sourceRef="B06_join" targetRef="B06_chat"/>
    <bpmn:sequenceFlow id="B06_Flow_11" sourceRef="B06_chat" targetRef="B06_rights"/>
    <bpmn:sequenceFlow id="B06_Flow_12" sourceRef="B06_rights" targetRef="B06_allowed"/>
    <bpmn:sequenceFlow id="B06_Flow_13" sourceRef="B06_allowed" targetRef="B06_send" name="Да"/>
    <bpmn:sequenceFlow id="B06_Flow_14" sourceRef="B06_allowed" targetRef="B06_deny" name="Нет"/>
    <bpmn:sequenceFlow id="B06_Flow_15" sourceRef="B06_send" targetRef="B06_e"/>
    <bpmn:sequenceFlow id="B06_Flow_16" sourceRef="B06_deny" targetRef="B06_e"/>
  </bpmn:process>
  <bpmn:collaboration id="B06_Collaboration">
    <bpmn:participant id="B06_Participant_main" name="Community, заявки, участники и чаты" processRef="B06_Process_main"/>
    <bpmn:participant id="B06_Participant_member" name="Пользователь / кандидат в Community"/>
    <bpmn:messageFlow id="B06_Flow_17" name="Заявка / запрос чата" sourceRef="B06_Participant_member" targetRef="B06_s"/>
    <bpmn:messageFlow id="B06_Flow_18" name="Разрешённые сообщения" sourceRef="B06_send" targetRef="B06_Participant_member"/>
  </bpmn:collaboration>
  <bpmn:process id="B07_Process_main" isExecutable="false">
    <bpmn:documentation>BR07 задаёт 250 символов, 30 минут / 1 / 2 / 3 часа, одно бесплатное облако в календарный день, без одновременных активных облаков. Источники: BR07, BR08, BR11. Рабочая спецификация, не модель исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="B07_LaneSet_main">
      <bpmn:lane id="B07_Lane_main_0" name="Представитель бизнеса · выданные права">
        <bpmn:flowNodeRef>B07_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B07_compose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B07_next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B07_policy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B07_Lane_main_1" name="LivCi · серверные проверки и данные">
        <bpmn:flowNodeRef>B07_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B07_allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B07_blocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B07_publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B07_active</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B07_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B07_expire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B07_repeat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B07_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="B07_s" name="Подготовить облако">
      <bpmn:outgoing>B07_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="B07_compose" name="Ввести текст до 250 символов и выбрать срок">
      <bpmn:incoming>B07_Flow_0</bpmn:incoming>
      <bpmn:outgoing>B07_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="B07_validate" name="Проверить доступ, открытость, квоту и активное облако">
      <bpmn:incoming>B07_Flow_1</bpmn:incoming>
      <bpmn:incoming>B07_Flow_11</bpmn:incoming>
      <bpmn:outgoing>B07_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B07_allowed" name="Запуск разрешён?">
      <bpmn:incoming>B07_Flow_2</bpmn:incoming>
      <bpmn:outgoing>B07_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>B07_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="B07_blocked" name="Показать причину; не списывать квоту">
      <bpmn:incoming>B07_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="B07_publish" name="Атомарно создать облако и учесть квоту">
      <bpmn:incoming>B07_Flow_4</bpmn:incoming>
      <bpmn:outgoing>B07_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B07_active" name="Показывать сверху Venue-маркера по правам">
      <bpmn:incoming>B07_Flow_5</bpmn:incoming>
      <bpmn:outgoing>B07_Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="B07_timer" name="Истёк выбранный срок 30 мин–3 ч">
      <bpmn:incoming>B07_Flow_6</bpmn:incoming>
      <bpmn:outgoing>B07_Flow_7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B07_timer_Timer">
        <bpmn:timeDuration>${cloudDuration}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="B07_expire" name="Завершить облако; убрать его с карты">
      <bpmn:incoming>B07_Flow_7</bpmn:incoming>
      <bpmn:outgoing>B07_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B07_repeat" name="Premium и автоповтор включены?">
      <bpmn:incoming>B07_Flow_8</bpmn:incoming>
      <bpmn:outgoing>B07_Flow_9</bpmn:outgoing>
      <bpmn:outgoing>B07_Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="B07_next" name="Следующий текст/параметры определены политикой?">
      <bpmn:incoming>B07_Flow_10</bpmn:incoming>
      <bpmn:outgoing>B07_Flow_11</bpmn:outgoing>
      <bpmn:outgoing>B07_Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="B07_e" name="Облако завершено">
      <bpmn:incoming>B07_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="B07_policy" name="Требуется согласованная политика повтора Q-A01">
      <bpmn:incoming>B07_Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B07_Flow_0" sourceRef="B07_s" targetRef="B07_compose"/>
    <bpmn:sequenceFlow id="B07_Flow_1" sourceRef="B07_compose" targetRef="B07_validate"/>
    <bpmn:sequenceFlow id="B07_Flow_2" sourceRef="B07_validate" targetRef="B07_allowed"/>
    <bpmn:sequenceFlow id="B07_Flow_3" sourceRef="B07_allowed" targetRef="B07_blocked" name="Нет"/>
    <bpmn:sequenceFlow id="B07_Flow_4" sourceRef="B07_allowed" targetRef="B07_publish" name="Да"/>
    <bpmn:sequenceFlow id="B07_Flow_5" sourceRef="B07_publish" targetRef="B07_active"/>
    <bpmn:sequenceFlow id="B07_Flow_6" sourceRef="B07_active" targetRef="B07_timer"/>
    <bpmn:sequenceFlow id="B07_Flow_7" sourceRef="B07_timer" targetRef="B07_expire"/>
    <bpmn:sequenceFlow id="B07_Flow_8" sourceRef="B07_expire" targetRef="B07_repeat"/>
    <bpmn:sequenceFlow id="B07_Flow_9" sourceRef="B07_repeat" targetRef="B07_e" name="Нет"/>
    <bpmn:sequenceFlow id="B07_Flow_10" sourceRef="B07_repeat" targetRef="B07_next" name="Да"/>
    <bpmn:sequenceFlow id="B07_Flow_11" sourceRef="B07_next" targetRef="B07_validate" name="Да: запуск строго после предыдущего"/>
    <bpmn:sequenceFlow id="B07_Flow_12" sourceRef="B07_next" targetRef="B07_policy" name="Нет"/>
  </bpmn:process>
  <bpmn:collaboration id="B07_Collaboration">
    <bpmn:participant id="B07_Participant_main" name="Облака активности: бесплатно и Premium" processRef="B07_Process_main"/>
  </bpmn:collaboration>
  <bpmn:process id="B08_Process_main" isExecutable="false">
    <bpmn:documentation>Длительность не более 5 часов. Круг на карте виден только пока Venue открыт; закрытие не доказывает автоматическую остановку самого потока. Источники: BR07. Рабочая спецификация, не модель исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="B08_LaneSet_main">
      <bpmn:lane id="B08_Lane_main_0" name="Представитель бизнеса · выданные права">
        <bpmn:flowNodeRef>B08_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B08_permissions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B08_run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B08_limit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B08_Lane_main_1" name="LivCi · серверные проверки и данные">
        <bpmn:flowNodeRef>B08_guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B08_can</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B08_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B08_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B08_stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B08_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="B08_s" name="Запрошен прямой эфир">
      <bpmn:outgoing>B08_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="B08_permissions" name="Разрешить камеру/микрофон и настроить эфир">
      <bpmn:incoming>B08_Flow_0</bpmn:incoming>
      <bpmn:outgoing>B08_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="B08_guard" name="Проверить право публикации и доступность Venue">
      <bpmn:incoming>B08_Flow_1</bpmn:incoming>
      <bpmn:outgoing>B08_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B08_can" name="Запуск разрешён?">
      <bpmn:incoming>B08_Flow_2</bpmn:incoming>
      <bpmn:outgoing>B08_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>B08_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="B08_no" name="Показать ошибку / ограничение">
      <bpmn:incoming>B08_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="B08_start" name="Создать сессию трансляции">
      <bpmn:incoming>B08_Flow_4</bpmn:incoming>
      <bpmn:outgoing>B08_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="B08_run" name="Вести эфир / завершить вручную">
      <bpmn:incoming>B08_Flow_5</bpmn:incoming>
      <bpmn:outgoing>B08_Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B08_limit" name="Не более 5 часов" attachedToRef="B08_run" cancelActivity="true">
      <bpmn:outgoing>B08_Flow_8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B08_limit_Timer">
        <bpmn:timeDuration>PT5H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="B08_stop" name="Завершить сессию; убрать активный круг">
      <bpmn:incoming>B08_Flow_6</bpmn:incoming>
      <bpmn:incoming>B08_Flow_8</bpmn:incoming>
      <bpmn:outgoing>B08_Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B08_end" name="Эфир завершён; запись не обещана">
      <bpmn:incoming>B08_Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B08_Flow_0" sourceRef="B08_s" targetRef="B08_permissions"/>
    <bpmn:sequenceFlow id="B08_Flow_1" sourceRef="B08_permissions" targetRef="B08_guard"/>
    <bpmn:sequenceFlow id="B08_Flow_2" sourceRef="B08_guard" targetRef="B08_can"/>
    <bpmn:sequenceFlow id="B08_Flow_3" sourceRef="B08_can" targetRef="B08_no" name="Нет"/>
    <bpmn:sequenceFlow id="B08_Flow_4" sourceRef="B08_can" targetRef="B08_start" name="Да"/>
    <bpmn:sequenceFlow id="B08_Flow_5" sourceRef="B08_start" targetRef="B08_run"/>
    <bpmn:sequenceFlow id="B08_Flow_6" sourceRef="B08_run" targetRef="B08_stop"/>
    <bpmn:sequenceFlow id="B08_Flow_7" sourceRef="B08_stop" targetRef="B08_end"/>
    <bpmn:sequenceFlow id="B08_Flow_8" sourceRef="B08_limit" targetRef="B08_stop" name="Лимит времени"/>
  </bpmn:process>
  <bpmn:collaboration id="B08_Collaboration">
    <bpmn:participant id="B08_Participant_main" name="Прямой эфир заведения" processRef="B08_Process_main"/>
  </bpmn:collaboration>
  <bpmn:process id="B09_Process_main" isExecutable="false">
    <bpmn:documentation>Подтверждено пользователем: 7 дней за $0 один раз без карты; месяц $150; год $1500. Платёжные операции относятся к подписке бизнеса, не к заказам посетителей. Источники: BR09, BR08. Рабочая спецификация, не модель исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="B09_LaneSet_main">
      <bpmn:lane id="B09_Lane_main_0" name="Представитель бизнеса · выданные права">
        <bpmn:flowNodeRef>B09_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_unavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_failed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B09_Lane_main_1" name="LivCi · серверные проверки и данные">
        <bpmn:flowNodeRef>B09_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_trial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_used</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_grant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_active</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_renew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_base</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B09_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="B09_s" name="Открыта подписка бизнеса">
      <bpmn:outgoing>B09_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="B09_choose" name="Выбрать пробный период / месяц / год">
      <bpmn:incoming>B09_Flow_0</bpmn:incoming>
      <bpmn:incoming>B09_Flow_6</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="B09_check" name="Проверить право управления подпиской">
      <bpmn:incoming>B09_Flow_1</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B09_plan" name="Выбран пробный период?">
      <bpmn:incoming>B09_Flow_2</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>B09_Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B09_trial" name="Проверить, не использовано ли пробное право">
      <bpmn:incoming>B09_Flow_3</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B09_used" name="Пробное право доступно?">
      <bpmn:incoming>B09_Flow_4</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>B09_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B09_unavailable" name="Пробный период недоступен; выбрать план">
      <bpmn:incoming>B09_Flow_5</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="B09_pay" name="Создать запрос оплаты выбранного плана">
      <bpmn:incoming>B09_Flow_8</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="B09_payment" name="Получить подтверждённый результат оплаты">
      <bpmn:incoming>B09_Flow_10</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B09_payment_Message"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="B09_paid" name="Оплата подтверждена?">
      <bpmn:incoming>B09_Flow_11</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_13</bpmn:outgoing>
      <bpmn:outgoing>B09_Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="B09_failed" name="Нет активации; показать статус / повтор">
      <bpmn:incoming>B09_Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="B09_grant" name="Идемпотентно активировать 5 прав до end_at">
      <bpmn:incoming>B09_Flow_7</bpmn:incoming>
      <bpmn:incoming>B09_Flow_14</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="B09_active" name="Premium действует до end_at">
      <bpmn:incoming>B09_Flow_15</bpmn:incoming>
      <bpmn:incoming>B09_Flow_18</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B09_active_Timer">
        <bpmn:timeDate>${subscriptionEndAt}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="B09_renew" name="Продление подтверждено по согласованным условиям?">
      <bpmn:incoming>B09_Flow_16</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_17</bpmn:outgoing>
      <bpmn:outgoing>B09_Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B09_extend" name="Продлить срок; сохранить единую подписку">
      <bpmn:incoming>B09_Flow_17</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B09_base" name="Снять истёкшие Premium-права; сохранить данные Venue">
      <bpmn:incoming>B09_Flow_19</bpmn:incoming>
      <bpmn:outgoing>B09_Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B09_end" name="Осталось бесплатное присутствие">
      <bpmn:incoming>B09_Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B09_Flow_0" sourceRef="B09_s" targetRef="B09_choose"/>
    <bpmn:sequenceFlow id="B09_Flow_1" sourceRef="B09_choose" targetRef="B09_check"/>
    <bpmn:sequenceFlow id="B09_Flow_2" sourceRef="B09_check" targetRef="B09_plan"/>
    <bpmn:sequenceFlow id="B09_Flow_3" sourceRef="B09_plan" targetRef="B09_trial" name="Да"/>
    <bpmn:sequenceFlow id="B09_Flow_4" sourceRef="B09_trial" targetRef="B09_used"/>
    <bpmn:sequenceFlow id="B09_Flow_5" sourceRef="B09_used" targetRef="B09_unavailable" name="Нет"/>
    <bpmn:sequenceFlow id="B09_Flow_6" sourceRef="B09_unavailable" targetRef="B09_choose"/>
    <bpmn:sequenceFlow id="B09_Flow_7" sourceRef="B09_used" targetRef="B09_grant" name="Да: P7D; без карты и автосписания"/>
    <bpmn:sequenceFlow id="B09_Flow_8" sourceRef="B09_plan" targetRef="B09_pay" name="Нет: $150 / $1500"/>
    <bpmn:sequenceFlow id="B09_Flow_10" sourceRef="B09_pay" targetRef="B09_payment"/>
    <bpmn:sequenceFlow id="B09_Flow_11" sourceRef="B09_payment" targetRef="B09_paid"/>
    <bpmn:sequenceFlow id="B09_Flow_13" sourceRef="B09_paid" targetRef="B09_failed" name="Нет / отменено"/>
    <bpmn:sequenceFlow id="B09_Flow_14" sourceRef="B09_paid" targetRef="B09_grant" name="Да"/>
    <bpmn:sequenceFlow id="B09_Flow_15" sourceRef="B09_grant" targetRef="B09_active"/>
    <bpmn:sequenceFlow id="B09_Flow_16" sourceRef="B09_active" targetRef="B09_renew"/>
    <bpmn:sequenceFlow id="B09_Flow_17" sourceRef="B09_renew" targetRef="B09_extend" name="Да"/>
    <bpmn:sequenceFlow id="B09_Flow_18" sourceRef="B09_extend" targetRef="B09_active"/>
    <bpmn:sequenceFlow id="B09_Flow_19" sourceRef="B09_renew" targetRef="B09_base" name="Нет / срок истёк"/>
    <bpmn:sequenceFlow id="B09_Flow_20" sourceRef="B09_base" targetRef="B09_end"/>
  </bpmn:process>
  <bpmn:collaboration id="B09_Collaboration">
    <bpmn:participant id="B09_Participant_main" name="Подписка Business Premium и её срок" processRef="B09_Process_main"/>
    <bpmn:participant id="B09_Participant_billing" name="Внешняя платёжная / биллинговая система · провайдер не выбран"/>
    <bpmn:messageFlow id="B09_Flow_9" name="Запрос оплаты подписки" sourceRef="B09_pay" targetRef="B09_Participant_billing"/>
    <bpmn:messageFlow id="B09_Flow_12" name="Проверенный результат" sourceRef="B09_Participant_billing" targetRef="B09_payment"/>
  </bpmn:collaboration>
  <bpmn:process id="B10_Process_main" isExecutable="false">
    <bpmn:documentation>Пять погодных состояний и подпись до 60 символов. Погода не загружается автоматически; приоритет не обходит права и открытость. Источники: BR08. Рабочая спецификация, не модель исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="B10_LaneSet_main">
      <bpmn:lane id="B10_Lane_main_0" name="Представитель бизнеса · выданные права">
        <bpmn:flowNodeRef>B10_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B10_edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B10_Lane_main_1" name="LivCi · серверные проверки и данные">
        <bpmn:flowNodeRef>B10_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B10_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B10_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B10_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B10_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B10_hide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B10_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="B10_s" name="Открыты настройки карты Premium">
      <bpmn:outgoing>B10_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="B10_edit" name="Выбрать погоду; ввести подпись; указать приоритет">
      <bpmn:incoming>B10_Flow_0</bpmn:incoming>
      <bpmn:incoming>B10_Flow_3</bpmn:incoming>
      <bpmn:outgoing>B10_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="B10_check" name="Проверить право, Premium, 5 состояний и длину">
      <bpmn:incoming>B10_Flow_1</bpmn:incoming>
      <bpmn:outgoing>B10_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B10_valid" name="Данные допустимы?">
      <bpmn:incoming>B10_Flow_2</bpmn:incoming>
      <bpmn:outgoing>B10_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>B10_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B10_save" name="Сохранить ручную настройку">
      <bpmn:incoming>B10_Flow_4</bpmn:incoming>
      <bpmn:outgoing>B10_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B10_open" name="Venue открыт и доступен для карты?">
      <bpmn:incoming>B10_Flow_5</bpmn:incoming>
      <bpmn:outgoing>B10_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>B10_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B10_show" name="Погода снизу слева; облако сверху; применить приоритет">
      <bpmn:incoming>B10_Flow_6</bpmn:incoming>
      <bpmn:outgoing>B10_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B10_hide" name="Хранить настройку без показа на живой карте">
      <bpmn:incoming>B10_Flow_7</bpmn:incoming>
      <bpmn:outgoing>B10_Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B10_end" name="Карта соответствует текущим правам">
      <bpmn:incoming>B10_Flow_8</bpmn:incoming>
      <bpmn:incoming>B10_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B10_Flow_0" sourceRef="B10_s" targetRef="B10_edit"/>
    <bpmn:sequenceFlow id="B10_Flow_1" sourceRef="B10_edit" targetRef="B10_check"/>
    <bpmn:sequenceFlow id="B10_Flow_2" sourceRef="B10_check" targetRef="B10_valid"/>
    <bpmn:sequenceFlow id="B10_Flow_3" sourceRef="B10_valid" targetRef="B10_edit" name="Нет: пояснить ошибку"/>
    <bpmn:sequenceFlow id="B10_Flow_4" sourceRef="B10_valid" targetRef="B10_save" name="Да"/>
    <bpmn:sequenceFlow id="B10_Flow_5" sourceRef="B10_save" targetRef="B10_open"/>
    <bpmn:sequenceFlow id="B10_Flow_6" sourceRef="B10_open" targetRef="B10_show" name="Да"/>
    <bpmn:sequenceFlow id="B10_Flow_7" sourceRef="B10_open" targetRef="B10_hide" name="Нет"/>
    <bpmn:sequenceFlow id="B10_Flow_8" sourceRef="B10_show" targetRef="B10_end"/>
    <bpmn:sequenceFlow id="B10_Flow_9" sourceRef="B10_hide" targetRef="B10_end"/>
  </bpmn:process>
  <bpmn:collaboration id="B10_Collaboration">
    <bpmn:participant id="B10_Participant_main" name="Premium: ручная погода и приоритет" processRef="B10_Process_main"/>
  </bpmn:collaboration>
  <bpmn:process id="B11_Process_main" isExecutable="false">
    <bpmn:documentation>Правило отправки проверяется для пары Venue/получатель непосредственно перед отправкой. Только измеримые агрегированные действия. Источники: BR08. Рабочая спецификация, не модель исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="B11_LaneSet_main">
      <bpmn:lane id="B11_Lane_main_0" name="Представитель бизнеса · выданные права">
        <bpmn:flowNodeRef>B11_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_context</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B11_Lane_main_1" name="LivCi · серверные проверки и данные">
        <bpmn:flowNodeRef>B11_sender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_skip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_aggregate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_verifyEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_eventKind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_consent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_metric</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11_eventEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="B11_s" name="Запрошено уведомление об активности">
      <bpmn:outgoing>B11_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="B11_context" name="Выбрать разрешённый контекст / материал">
      <bpmn:incoming>B11_Flow_0</bpmn:incoming>
      <bpmn:outgoing>B11_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="B11_sender" name="Проверить право отправителя и активный Premium">
      <bpmn:incoming>B11_Flow_1</bpmn:incoming>
      <bpmn:outgoing>B11_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B11_eligible" name="Сформировать кандидатов без раскрытия личного GPS">
      <bpmn:incoming>B11_Flow_2</bpmn:incoming>
      <bpmn:outgoing>B11_Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B11_guard" name="Согласие, расстояние ≤1,5 км и лимит ≥90 мин?">
      <bpmn:incoming>B11_Flow_3</bpmn:incoming>
      <bpmn:outgoing>B11_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>B11_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="B11_skip" name="Не отправлять; не расходовать право получателя">
      <bpmn:incoming>B11_Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="B11_reserve" name="Атомарно зарезервировать пару Venue/получатель">
      <bpmn:incoming>B11_Flow_5</bpmn:incoming>
      <bpmn:outgoing>B11_Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="B11_send" name="Отправить разрешённое уведомление">
      <bpmn:incoming>B11_Flow_6</bpmn:incoming>
      <bpmn:outgoing>B11_Flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="B11_result" name="Учесть отправку; не предполагать доставку">
      <bpmn:incoming>B11_Flow_7</bpmn:incoming>
      <bpmn:outgoing>B11_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B11_aggregate" name="Обновить агрегаты; не считать визит или выручку">
      <bpmn:incoming>B11_Flow_8</bpmn:incoming>
      <bpmn:outgoing>B11_Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B11_end" name="Результат доступен в бизнес-аналитике по правам">
      <bpmn:incoming>B11_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="B11_received" name="Получено измеримое событие / отзыв согласия">
      <bpmn:outgoing>B11_Flow_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B11_received_Message"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="B11_verifyEvent" name="Проверить источник и связь с отправкой">
      <bpmn:incoming>B11_Flow_11</bpmn:incoming>
      <bpmn:outgoing>B11_Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B11_eventKind" name="Отзыв согласия?">
      <bpmn:incoming>B11_Flow_12</bpmn:incoming>
      <bpmn:outgoing>B11_Flow_13</bpmn:outgoing>
      <bpmn:outgoing>B11_Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B11_consent" name="Обновить согласие для будущих проверок">
      <bpmn:incoming>B11_Flow_13</bpmn:incoming>
      <bpmn:outgoing>B11_Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B11_metric" name="Учесть только подтверждённую доставку/открытие">
      <bpmn:incoming>B11_Flow_14</bpmn:incoming>
      <bpmn:outgoing>B11_Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B11_eventEnd" name="Состояние и агрегаты обновлены">
      <bpmn:incoming>B11_Flow_15</bpmn:incoming>
      <bpmn:incoming>B11_Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B11_Flow_0" sourceRef="B11_s" targetRef="B11_context"/>
    <bpmn:sequenceFlow id="B11_Flow_1" sourceRef="B11_context" targetRef="B11_sender"/>
    <bpmn:sequenceFlow id="B11_Flow_2" sourceRef="B11_sender" targetRef="B11_eligible"/>
    <bpmn:sequenceFlow id="B11_Flow_3" sourceRef="B11_eligible" targetRef="B11_guard"/>
    <bpmn:sequenceFlow id="B11_Flow_4" sourceRef="B11_guard" targetRef="B11_skip" name="Нет / GPS или согласие неизвестны"/>
    <bpmn:sequenceFlow id="B11_Flow_5" sourceRef="B11_guard" targetRef="B11_reserve" name="Да; повторная атомарная проверка"/>
    <bpmn:sequenceFlow id="B11_Flow_6" sourceRef="B11_reserve" targetRef="B11_send"/>
    <bpmn:sequenceFlow id="B11_Flow_7" sourceRef="B11_send" targetRef="B11_result"/>
    <bpmn:sequenceFlow id="B11_Flow_8" sourceRef="B11_result" targetRef="B11_aggregate"/>
    <bpmn:sequenceFlow id="B11_Flow_9" sourceRef="B11_aggregate" targetRef="B11_end"/>
    <bpmn:sequenceFlow id="B11_Flow_11" sourceRef="B11_received" targetRef="B11_verifyEvent"/>
    <bpmn:sequenceFlow id="B11_Flow_12" sourceRef="B11_verifyEvent" targetRef="B11_eventKind"/>
    <bpmn:sequenceFlow id="B11_Flow_13" sourceRef="B11_eventKind" targetRef="B11_consent" name="Да"/>
    <bpmn:sequenceFlow id="B11_Flow_14" sourceRef="B11_eventKind" targetRef="B11_metric" name="Нет: доставка / открытие"/>
    <bpmn:sequenceFlow id="B11_Flow_15" sourceRef="B11_consent" targetRef="B11_eventEnd"/>
    <bpmn:sequenceFlow id="B11_Flow_16" sourceRef="B11_metric" targetRef="B11_eventEnd"/>
  </bpmn:process>
  <bpmn:collaboration id="B11_Collaboration">
    <bpmn:participant id="B11_Participant_main" name="Уведомления: согласие, радиус, лимит; аналитика" processRef="B11_Process_main"/>
    <bpmn:participant id="B11_Participant_recipient" name="Обычный пользователь: согласие и уведомление"/>
    <bpmn:messageFlow id="B11_Flow_10" name="Уведомление с ссылкой на доступный объект" sourceRef="B11_send" targetRef="B11_Participant_recipient"/>
    <bpmn:messageFlow id="B11_Flow_17" name="Подтверждённая доставка, открытие или отзыв" sourceRef="B11_Participant_recipient" targetRef="B11_received"/>
  </bpmn:collaboration>
  <bpmn:process id="B12_Process_main" isExecutable="false">
    <bpmn:documentation>Названия OWNER/ADMIN/ORGANIZER/MODERATOR/MEMBER не подменяют согласованную матрицу полномочий. Членство само по себе не выдаёт административные права. Источники: BR06, BR09. Рабочая спецификация, не модель исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="B12_LaneSet_main">
      <bpmn:lane id="B12_Lane_main_0" name="Представитель бизнеса · выданные права">
        <bpmn:flowNodeRef>B12_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B12_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B12_Lane_main_1" name="LivCi · серверные проверки и данные">
        <bpmn:flowNodeRef>B12_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B12_policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B12_can</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B12_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B12_recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B12_commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B12_invalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B12_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="B12_s" name="Сотрудник запрашивает действие">
      <bpmn:outgoing>B12_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="B12_session" name="Проверить сессию и принадлежность рабочему пространству">
      <bpmn:incoming>B12_Flow_0</bpmn:incoming>
      <bpmn:outgoing>B12_Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="B12_policy" name="Проверить capability для объекта и действия">
      <bpmn:incoming>B12_Flow_1</bpmn:incoming>
      <bpmn:outgoing>B12_Flow_2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="B12_can" name="Разрешение выдано?">
      <bpmn:incoming>B12_Flow_2</bpmn:incoming>
      <bpmn:outgoing>B12_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>B12_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="B12_deny" name="Отказать без изменения данных и утечки содержимого">
      <bpmn:incoming>B12_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="B12_request" name="Подтвердить целевое изменение">
      <bpmn:incoming>B12_Flow_4</bpmn:incoming>
      <bpmn:outgoing>B12_Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="B12_recheck" name="Перепроверить право и версию объекта при записи">
      <bpmn:incoming>B12_Flow_5</bpmn:incoming>
      <bpmn:outgoing>B12_Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B12_commit" name="Сохранить изменение и журнал действия">
      <bpmn:incoming>B12_Flow_6</bpmn:incoming>
      <bpmn:outgoing>B12_Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B12_invalidate" name="При смене доступа обновить доступ активных сессий">
      <bpmn:incoming>B12_Flow_7</bpmn:incoming>
      <bpmn:outgoing>B12_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B12_end" name="Изменены только разрешённые данные">
      <bpmn:incoming>B12_Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B12_Flow_0" sourceRef="B12_s" targetRef="B12_session"/>
    <bpmn:sequenceFlow id="B12_Flow_1" sourceRef="B12_session" targetRef="B12_policy"/>
    <bpmn:sequenceFlow id="B12_Flow_2" sourceRef="B12_policy" targetRef="B12_can"/>
    <bpmn:sequenceFlow id="B12_Flow_3" sourceRef="B12_can" targetRef="B12_deny" name="Нет / неизвестная политика"/>
    <bpmn:sequenceFlow id="B12_Flow_4" sourceRef="B12_can" targetRef="B12_request" name="Да"/>
    <bpmn:sequenceFlow id="B12_Flow_5" sourceRef="B12_request" targetRef="B12_recheck"/>
    <bpmn:sequenceFlow id="B12_Flow_6" sourceRef="B12_recheck" targetRef="B12_commit"/>
    <bpmn:sequenceFlow id="B12_Flow_7" sourceRef="B12_commit" targetRef="B12_invalidate"/>
    <bpmn:sequenceFlow id="B12_Flow_8" sourceRef="B12_invalidate" targetRef="B12_end"/>
  </bpmn:process>
  <bpmn:collaboration id="B12_Collaboration">
    <bpmn:participant id="B12_Participant_main" name="Права сотрудника и безопасное управление" processRef="B12_Process_main"/>
  </bpmn:collaboration>
  <bpmn:process id="B13_Process_main" isExecutable="false">
    <bpmn:documentation>Обычный пользователь остаётся в личном приложении. Бизнес-панель, внутренние роли, платежи подписки и служебные чаты ему не показываются. Источники: BR11, BR16, BR13, BR14, BR10, BR06, BR08. Рабочая спецификация, не модель исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="B13_LaneSet_main">
      <bpmn:lane id="B13_Lane_main_0" name="Обычный пользователь · личное приложение">
