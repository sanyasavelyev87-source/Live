      <bpmn:messageEventDefinition id="B13_bs_Message"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="B13_auth" name="Проверить аутентификацию, объект, членство и правила">
      <bpmn:incoming>B13_Flow_21</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B13_authorized" name="Действие разрешено?">
      <bpmn:incoming>B13_Flow_22</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_23</bpmn:outgoing>
      <bpmn:outgoing>B13_Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B13_commit" name="Сохранить результат идемпотентно">
      <bpmn:incoming>B13_Flow_23</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="B13_rs" name="Вернуть статус без чужих персональных данных">
      <bpmn:incoming>B13_Flow_24</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="B13_needsBusiness" name="Создана заявка или сообщение?">
      <bpmn:incoming>B13_Flow_25</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_26</bpmn:outgoing>
      <bpmn:outgoing>B13_Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="B13_notify" name="Передать в разрешённый раздел кабинета">
      <bpmn:incoming>B13_Flow_26</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_28</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="B13_be" name="Обновить допустимые агрегаты">
      <bpmn:incoming>B13_Flow_27</bpmn:incoming>
      <bpmn:incoming>B13_Flow_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="B13_denyAction" name="Отклонить без изменения данных">
      <bpmn:incoming>B13_Flow_29</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="B13_denyResponse" name="Вернуть причину ограничения">
      <bpmn:incoming>B13_Flow_30</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_31</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="B13_denyEnd" name="Действие не выполнено">
      <bpmn:incoming>B13_Flow_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B13_Flow_15" sourceRef="B13_as" targetRef="B13_filter"/>
