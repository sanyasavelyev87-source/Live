    <bpmn:sequenceFlow id="B13_Flow_5" sourceRef="B13_can" targetRef="B13_choose" name="Да"/>
    <bpmn:sequenceFlow id="B13_Flow_6" sourceRef="B13_choose" targetRef="B13_what"/>
    <bpmn:sequenceFlow id="B13_Flow_7" sourceRef="B13_what" targetRef="B13_read" name="Прочитать"/>
    <bpmn:sequenceFlow id="B13_Flow_8" sourceRef="B13_what" targetRef="B13_route" name="Связаться / маршрут"/>
    <bpmn:sequenceFlow id="B13_Flow_9" sourceRef="B13_what" targetRef="B13_act" name="Взаимодействовать"/>
    <bpmn:sequenceFlow id="B13_Flow_10" sourceRef="B13_read" targetRef="B13_e"/>
    <bpmn:sequenceFlow id="B13_Flow_11" sourceRef="B13_route" targetRef="B13_e"/>
    <bpmn:sequenceFlow id="B13_Flow_12" sourceRef="B13_act" targetRef="B13_sendact"/>
    <bpmn:sequenceFlow id="B13_Flow_13" sourceRef="B13_sendact" targetRef="B13_actionreply"/>
    <bpmn:sequenceFlow id="B13_Flow_14" sourceRef="B13_actionreply" targetRef="B13_e"/>
  </bpmn:process>
  <bpmn:process id="B13_Process_app" isExecutable="false">
    <bpmn:documentation>Обычный пользователь остаётся в личном приложении. Бизнес-панель, внутренние роли, платежи подписки и служебные чаты ему не показываются. Источники: BR11, BR16, BR13, BR14, BR10, BR06, BR08. Рабочая спецификация, не модель исполнения в движке.</bpmn:documentation>
