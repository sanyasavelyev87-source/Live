      <bpmn:outgoing>B13_Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="B13_sendact" name="Отправить выбранное действие">
      <bpmn:incoming>B13_Flow_12</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="B13_actionreply" name="Получить статус, данные или ограничение">
      <bpmn:incoming>B13_Flow_13</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_14</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="B13_e" name="Результат показан в личном приложении">
      <bpmn:incoming>B13_Flow_10</bpmn:incoming>
      <bpmn:incoming>B13_Flow_11</bpmn:incoming>
      <bpmn:incoming>B13_Flow_14</bpmn:incoming>
    </bpmn:endEvent>
