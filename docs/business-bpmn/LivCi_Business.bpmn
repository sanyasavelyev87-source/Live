      <bpmn:outgoing>B13_Flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="B13_reply" name="Получить публичную карточку / ограничение">
      <bpmn:incoming>B13_Flow_2</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="B13_can" name="Просмотр доступен?">
      <bpmn:incoming>B13_Flow_3</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>B13_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="B13_no" name="Увидеть причину недоступности">
      <bpmn:incoming>B13_Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="B13_choose" name="Выбрать раздел или действие">
      <bpmn:incoming>B13_Flow_5</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="B13_what" name="Что делает пользователь?">
      <bpmn:incoming>B13_Flow_6</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_7</bpmn:outgoing>
      <bpmn:outgoing>B13_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>B13_Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B13_read" name="Сведения, меню, цены, услуги, медиа и публикации">
      <bpmn:incoming>B13_Flow_7</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="B13_route" name="Маршрут / публичный телефон / email">
      <bpmn:incoming>B13_Flow_8</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_11</bpmn:outgoing>
    </bpmn:userTask>
