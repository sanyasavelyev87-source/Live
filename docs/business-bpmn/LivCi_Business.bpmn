    <bpmn:sequenceFlow id="B13_Flow_23" sourceRef="B13_authorized" targetRef="B13_commit" name="Да"/>
    <bpmn:sequenceFlow id="B13_Flow_24" sourceRef="B13_commit" targetRef="B13_rs"/>
    <bpmn:sequenceFlow id="B13_Flow_25" sourceRef="B13_rs" targetRef="B13_needsBusiness"/>
