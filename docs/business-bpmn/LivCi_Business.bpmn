    <bpmn:sequenceFlow id="B02_Flow_8" sourceRef="B02_choose" targetRef="B02_cancel" name="Отменить"/>
    <bpmn:sequenceFlow id="B02_Flow_9" sourceRef="B02_cancel" targetRef="B02_ec"/>
    <bpmn:sequenceFlow id="B02_Flow_10" sourceRef="B02_choose" targetRef="B02_validate" name="Сохранить"/>
    <bpmn:sequenceFlow id="B02_Flow_11" sourceRef="B02_validate" targetRef="B02_valid"/>
    <bpmn:sequenceFlow id="B02_Flow_12" sourceRef="B02_valid" targetRef="B02_edit" name="Ошибка / конфликт версии"/>
    <bpmn:sequenceFlow id="B02_Flow_13" sourceRef="B02_valid" targetRef="B02_save" name="Да"/>
    <bpmn:sequenceFlow id="B02_Flow_14" sourceRef="B02_save" targetRef="B02_project"/>
    <bpmn:sequenceFlow id="B02_Flow_15" sourceRef="B02_project" targetRef="B02_e"/>
  </bpmn:process>
  <bpmn:collaboration id="B02_Collaboration">
    <bpmn:participant id="B02_Participant_main" name="Карточка заведения: редактирование и публичный вид" processRef="B02_Process_main"/>
  </bpmn:collaboration>
  <bpmn:process id="B03_Process_main" isExecutable="false">
    <bpmn:documentation>Сохранение карточки и открытость заведения — разные состояния. Закрытие не удаляет меню, события, Community или аккаунт. Источники: BR11, BR16, BR07, BR08. Рабочая спецификация, не модель исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="B03_LaneSet_main">
      <bpmn:lane id="B03_Lane_main_0" name="Представитель бизнеса · выданные права">
        <bpmn:flowNodeRef>B03_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B03_input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="B03_Lane_main_1" name="LivCi · серверные проверки и данные">
        <bpmn:flowNodeRef>B03_trigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B03_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B03_effective</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B03_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B03_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B03_decor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B03_hide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B03_keep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B03_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="B03_s" name="Изменились часы, ручной статус или время">
      <bpmn:outgoing>B03_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="B03_trigger" name="Ручное изменение?">
      <bpmn:incoming>B03_Flow_0</bpmn:incoming>
      <bpmn:outgoing>B03_Flow_1</bpmn:outgoing>
      <bpmn:outgoing>B03_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B03_input" name="Указать часы / ручной статус">
      <bpmn:incoming>B03_Flow_1</bpmn:incoming>
      <bpmn:outgoing>B03_Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="B03_auth" name="Проверить право; сохранить изменения">
      <bpmn:incoming>B03_Flow_2</bpmn:incoming>
      <bpmn:outgoing>B03_Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="B03_effective" name="Рассчитать статус в часовом поясе Venue">
      <bpmn:incoming>B03_Flow_3</bpmn:incoming>
      <bpmn:incoming>B03_Flow_5</bpmn:incoming>
      <bpmn:outgoing>B03_Flow_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="B03_open" name="Venue открыт и доступен для карты?">
      <bpmn:incoming>B03_Flow_4</bpmn:incoming>
      <bpmn:outgoing>B03_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>B03_Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B03_show" name="Показать разрешённый Venue-маркер">
      <bpmn:incoming>B03_Flow_6</bpmn:incoming>
      <bpmn:outgoing>B03_Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B03_decor" name="Применить Premium, облако, погоду, эфир по правам">
      <bpmn:incoming>B03_Flow_7</bpmn:incoming>
      <bpmn:outgoing>B03_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B03_hide" name="Скрыть маркер, облако, погоду и круг эфира">
      <bpmn:incoming>B03_Flow_9</bpmn:incoming>
      <bpmn:outgoing>B03_Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B03_keep" name="Сохранить карточку и содержимое">
      <bpmn:incoming>B03_Flow_10</bpmn:incoming>
      <bpmn:outgoing>B03_Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="B03_e" name="Публичная карта обновлена">
      <bpmn:incoming>B03_Flow_8</bpmn:incoming>
      <bpmn:incoming>B03_Flow_11</bpmn:incoming>
    </bpmn:endEvent>
