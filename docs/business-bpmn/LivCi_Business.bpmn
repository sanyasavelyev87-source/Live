    <bpmn:sequenceFlow id="B03_Flow_1" sourceRef="B03_trigger" targetRef="B03_input" name="Да"/>
    <bpmn:sequenceFlow id="B03_Flow_2" sourceRef="B03_input" targetRef="B03_auth"/>
    <bpmn:sequenceFlow id="B03_Flow_3" sourceRef="B03_auth" targetRef="B03_effective"/>
    <bpmn:sequenceFlow id="B03_Flow_4" sourceRef="B03_effective" targetRef="B03_open"/>
    <bpmn:sequenceFlow id="B03_Flow_5" sourceRef="B03_trigger" targetRef="B03_effective" name="Нет: наступило время пересчёта"/>
    <bpmn:sequenceFlow id="B03_Flow_6" sourceRef="B03_open" targetRef="B03_show" name="Да"/>
    <bpmn:sequenceFlow id="B03_Flow_7" sourceRef="B03_show" targetRef="B03_decor"/>
    <bpmn:sequenceFlow id="B03_Flow_8" sourceRef="B03_decor" targetRef="B03_e"/>
    <bpmn:sequenceFlow id="B03_Flow_9" sourceRef="B03_open" targetRef="B03_hide" name="Нет"/>
    <bpmn:sequenceFlow id="B03_Flow_10" sourceRef="B03_hide" targetRef="B03_keep"/>
    <bpmn:sequenceFlow id="B03_Flow_11" sourceRef="B03_keep" targetRef="B03_e"/>
  </bpmn:process>
  <bpmn:collaboration id="B03_Collaboration">
    <bpmn:participant id="B03_Participant_main" name="Открытость Venue и видимость на карте" processRef="B03_Process_main"/>
  </bpmn:collaboration>
  <bpmn:process id="B04_Process_main" isExecutable="false">
    <bpmn:documentation>Управление ассортиментом и контентом без заказа, корзины, оплаты блюд и бронирования. Источники: BR13, BR14, BR12, BR16. Рабочая спецификация, не модель исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="B04_LaneSet_main">
