        <bpmn:flowNodeRef>B13_entry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B13_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B13_reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B13_can</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B13_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B13_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B13_what</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B13_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B13_route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B13_act</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B13_sendact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B13_actionreply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B13_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="B13_s" name="Найден Venue / Event / Community">
      <bpmn:outgoing>B13_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="B13_entry" name="Открыть с карты, из Community, события или уведомления">
      <bpmn:incoming>B13_Flow_0</bpmn:incoming>
      <bpmn:outgoing>B13_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="B13_req" name="Запросить карточку">
