      <bpmn:incoming>B04_Flow_1</bpmn:incoming>
      <bpmn:incoming>B04_Flow_8</bpmn:incoming>
      <bpmn:outgoing>B04_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>B04_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B04_menu" name="Категория / позиция: фото, имя, описание, цена">
